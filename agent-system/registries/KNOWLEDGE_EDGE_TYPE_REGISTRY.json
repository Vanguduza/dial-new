  "registry_version": "vekl-2.2-rev5",
  "required_edge_fields": [
    "creation_graph_generation",
    "derivation_class",
    "graph_schema_version",
    "route_class",
    "source_content_hash",
    "source_ref",
    "tombstoned"
  ],
  "schema_version": 1,
  "traversal_policy": {
    "directed_by_default": true,
    "reverse_twin_requires_declaration": true,
    "hub_degree_threshold": 100,
    "hub_rule": "REACHABLE_NOT_EXPANDABLE",
    "budget_source": "KNOWLEDGE_ROUTE_REGISTRY.max_hops, selected per edge route_class",
    "unmatched_route_class": "NOT_TRAVERSED",
    "resource_layer_is_terminal": {
      "node_types": [
        "ENGINEERING_RESOURCE",
        "SKILL_RESOURCE",
        "TOOL_RESOURCE",
        "MCP_RESOURCE",
        "PLUGIN_RESOURCE"
      ],
      "rule": "EXPAND_ONLY_WITHIN_RESOURCE_LAYER",
      "why": "Retrieval reads only resource nodes out of the neighbourhood; every other visited node is provenance. Walking out of a resource along `supports` into the Units it serves reached other Units' contracts, features and tests and added nothing retrievable - the cross-unit leakage the hub rule only partly contained, and it reappeared the moment the concrete task began entering the graph at a concern. Resource-to-resource edges (supersedes, conflicts_with, specialised_as) stay traversable so a superseding resource is still discoverable."
    }
  }
