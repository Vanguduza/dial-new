{
  "schema_version": 1,
  "registry_version": "dial-google-capabilities-1",
  "authority": "PROJECT_TRUTH_SUBORDINATE_EXTERNAL_CAPABILITY_STATUS",
  "status_vocabulary": [
    "DISCOVERED",
    "IMPLEMENTED",
    "AUTH_REQUIRED",
    "AUTHENTICATED",
    "LIVE_QUALIFIED",
    "ORCHESTRATED",
    "INTEGRATED",
    "DEGRADED",
    "DISABLED",
    "QUARANTINED"
  ],
  "integration_rule": "INTEGRATED requires provider-specific Definition-of-Done evidence; architecture or fallback availability is insufficient.",
  "capabilities": [
    {
      "capability_id": "DEV-ANTIGRAVITY",
      "provider": "google",
      "product": "Google Antigravity",
      "role": "DEVELOPMENT_WORKER",
      "runtime_dependency": false,
      "authority_class": "EXECUTION_WORKER",
      "supported_mode": "ANTIGRAVITY_CLI_HEADLESS",
      "transport": "agy --print --output-format json",
      "credential_profile": "google-antigravity-user-or-cloud-project",
      "kill_switch": "DIAL_ANTIGRAVITY_ENABLED",
      "default_enabled": false,
      "required_proofs": [
        "implementation",
        "authentication",
        "live_canary",
        "guarded_write_denial",
        "network_permission_denial",
        "receipt",
        "orchestrated_unit_execution",
        "fallback"
      ],
      "forbidden": [
        "MANAGER_RUNTIME",
        "DIRECT_MASTER_WRITE",
        "PRODUCTION_SECRET_ACCESS",
        "PRODUCTION_RUNTIME_DEPENDENCY",
        "MONEY_AUTHORITY"
      ]
    },
    {
      "capability_id": "DESIGN-STITCH",
      "provider": "google",
      "product": "Google Stitch",
      "role": "DESIGN_PROVIDER",
      "runtime_dependency": false,
      "authority_class": "NON_AUTHORITATIVE_DESIGN_PROVIDER",
      "supported_mode": "STITCH_MCP_API",
      "transport": "https://stitch.googleapis.com/mcp",
      "credential_profile": "stitch-api-key-or-oauth",
      "kill_switch": "DIAL_STITCH_ENABLED",
      "live_test_switch": "DIAL_STITCH_LIVE_TESTS_ENABLED",
      "default_enabled": false,
      "required_proofs": [
        "implementation",
        "authentication",
        "live_project_list",
        "live_sandbox_screen",
        "artifact_quarantine",
        "design_manifest",
        "visual_functional_responsive_acceptance",
        "orchestrated_unit_execution",
        "outage_fallback"
      ],
      "forbidden": [
        "DESIGN_AUTHORITY",
        "DIRECT_PROVIDER_OUTPUT_EXECUTION",
        "CUSTOMER_RUNTIME_DEPENDENCY",
        "PRODUCTION_SECRET_EMBEDDING",
        "MONEY_AUTHORITY"
      ]
    },
    {
      "capability_id": "CREATIVE-POMELLI",
      "provider": "google",
      "product": "Google Pomelli",
      "role": "GMPC_EXTERNAL_CREATIVE_PROVIDER",
      "runtime_dependency": false,
      "authority_class": "NON_AUTHORITATIVE_CREATIVE_PROVIDER",
      "supported_mode": "GOVERNED_MANUAL_WEB_AND_DIAL_INGEST",
      "transport": "human-operated Pomelli web application; no cookie/browser automation",
      "credential_profile": "human-google-account-session-not-stored-by-dial",
      "kill_switch": "DIAL_POMELLI_INGEST_ENABLED",
      "future_api_switch": "DIAL_POMELLI_API_ENABLED",
      "default_enabled": false,
      "required_proofs": [
        "implementation",
        "sanitized_business_dna",
        "forbidden_data_denial",
        "manual_export_ingest",
        "asset_provenance_hash",
        "product_fidelity_review",
        "claims_review",
        "rights_review",
        "commercial_binding_review",
        "publication_audit",
        "revocation_audit",
        "staging_creative_slice"
      ],
      "forbidden": [
        "COOKIE_AUTOMATION",
        "UI_SCRAPING_AS_API",
        "CUSTOMER_PII_EGRESS",
        "PRICE_AUTHORITY",
        "PROMOTION_AUTHORITY",
        "AD_SPEND_AUTHORITY",
        "PRODUCTION_SITE_AUTHORITY",
        "MONEY_AUTHORITY"
      ],
      "functional_owner": "GMPC",
      "provider_admission_only": true,
      "production_content_allowed_after_gmpc_admission": true,
      "production_feature_bindings": [
        "GMPC-F050",
        "GMPC-F051",
        "GMPC-F052",
        "GMPC-F053",
        "GMPC-F060",
        "GMPC-F061",
        "GMPC-F062",
        "GMPC-F140",
        "GMPC-F170",
        "GMPC-F180",
        "GMPC-F181",
        "GMPC-F202",
        "GMPC-F209"
      ],
      "integration_rule": "Provider availability is reported here; creative truth, approvals, publication, expiry and revocation remain GMPC-owned."
    }
  ]
}
