{
  "schema_version": 1,
  "authority": "HERMES",
  "principle": "Commander capability is full. Authority to use it comes from owner instructions or explicitly registered automations; host-role and domain authorities remain independent enforcement boundaries.",
  "targets": [
    {
      "commander_id": "dial_hermes_local_commander",
      "host": "dial-hermes-control",
      "host_class": "CONTROL_AUTHORITY",
      "transport": "LOCAL_STDIO",
      "capability_surface": "FULL",
      "normal_project_entry": true
    },
    {
      "commander_id": "van_trading_local_commander",
      "host": "van-trading-core",
      "host_class": "TRADING_EXECUTION_SURFACE",
      "transport": "PRIVATE_SSH_STDIO",
      "capability_surface": "FULL",
      "normal_project_entry": false
    }
  ],
  "normal_control_exclusions": [
    "oracle-admin",
    "vekl-worker"
  ],
  "automations": [
    {
      "automation_id": "CHATGPT_SESSION_LIFECYCLE",
      "enabled": true,
      "targets": ["dial_hermes_local_commander", "van_trading_local_commander"],
      "allowed_tools": [
        "start_process",
        "interact_with_process",
        "list_processes",
        "list_sessions",
        "kill_process",
        "read_file",
        "read_multiple_files",
        "list_directory",
        "get_file_info"
      ],
      "purpose": "Start, inspect, interact with, checkpoint and recover Hermes-managed ChatGPT/Codex sessions.",
      "owner_approval_required": false
    },
    {
      "automation_id": "WORKSPACE_MAINTENANCE",
      "enabled": true,
      "targets": ["dial_hermes_local_commander", "van_trading_local_commander"],
      "allowed_tools": [
        "read_file",
        "read_multiple_files",
        "write_file",
        "edit_block",
        "move_file",
        "list_directory",
        "get_file_info",
        "start_search",
        "get_more_search_results"
      ],
      "purpose": "Perform deterministic workspace operations that are part of an already-authorized Hermes mission.",
      "owner_approval_required": false
    },
    {
      "automation_id": "LOCAL_RUNTIME_RECOVERY",
      "enabled": true,
      "targets": ["dial_hermes_local_commander", "van_trading_local_commander"],
      "allowed_tools": [
        "list_processes",
        "list_sessions",
        "start_process",
        "interact_with_process",
        "kill_process",
        "get_config"
      ],
      "purpose": "Recover local subordinate runtimes and interactive worker sessions after a detected failure.",
      "owner_approval_required": false
    },
    {
      "automation_id": "COMMANDER_CONFIGURATION_CHANGE",
      "enabled": true,
      "targets": ["dial_hermes_local_commander", "van_trading_local_commander"],
      "allowed_tools": [
        "get_config",
        "set_config_value"
      ],
      "purpose": "Change Commander configuration when an approved owner instruction or maintenance procedure requires it.",
      "owner_approval_required": true
    }
  ],
  "domain_boundaries": {
    "trading": "Full Commander control never replaces VATI risk authority or the canonical broker execution path.",
    "recovery": "GitHub plus OCI Run Command is independent of both subordinate Commanders.",
    "host_roles": "A full Commander cannot make oracle-admin a development venue or bypass an immutable host-role guard."
  }
}
