{
  "schema_version": 1,
  "policy_id": "DIAL_STATE_AWARE_HOUSEKEEPING_V1",
  "authority": "HERMES_CONTROL_AUTHORITY",
  "principle": "DELETE_BY_LIFECYCLE_STATE_NOT_BY_AGE",
  "reconciliation_timer_is_secondary": true,
  "resource_classes": {
    "FOUNDATION": {
      "automatic_delete": false,
      "examples": [
        "Android SDK",
        "JDK",
        "Node",
        "Python",
        "Git",
        "Docker",
        "Hermes",
        "Codex",
        "Claude Code",
        "ADB",
        "CMake",
        "Playwright runtime"
      ]
    },
    "CANONICAL": {
      "automatic_delete": false,
      "examples": [
        "Project Truth",
        "VEKL admitted knowledge",
        "Hermes state",
        "VATI/trading ledgers",
        "n8n/PostgreSQL state",
        "release artifacts",
        "evidence required by authority"
      ]
    },
    "PERSISTENT_OPERATIONAL": {
      "automatic_delete": false,
      "examples": [
        "active project checkout",
        "database volume",
        "browser profile explicitly marked persistent",
        "recovery material"
      ]
    },
    "DERIVED": {
      "automatic_delete": true,
      "requires_evidence": true,
      "examples": [
        "Android build tree",
        "compiled output",
        "coverage tree",
        "provider worktree after admission"
      ]
    },
    "EPHEMERAL": {
      "automatic_delete": true,
      "requires_evidence": false,
      "examples": [
        "temporary test APK",
        "scratch workspace",
        "temporary browser profile",
        "provider sandbox"
      ]
    },
    "CACHE": {
      "automatic_delete": true,
      "requires_evidence": false,
      "examples": [
        "dependency cache",
        "BuildKit cache",
        "download cache"
      ]
    }
  },
  "state_machine": [
    "ACTIVE",
    "WAITING_ADMISSION",
    "GC_ELIGIBLE",
    "QUARANTINED",
    "DELETED",
    "RETAINED"
  ],
  "mandatory_gates": [
    "RESOURCE_REGISTERED_OR_BOUNDED_DISCOVERY",
    "NOT_PROTECTED_CLASS",
    "PATH_WITHIN_DECLARED_RESOURCE",
    "NO_ACTIVE_AEF_LEASE",
    "NO_ACTIVE_PROCESS_USE",
    "LIFECYCLE_TRIGGER_SATISFIED",
    "RECONSTRUCTABILITY_PROVEN_WHEN_REQUIRED"
  ],
  "repository_deletion": {
    "required": [
      "PROJECT_OR_MISSION_COMPLETE",
      "WORKING_TREE_CLEAN",
      "NO_STASH",
      "NO_ADDITIONAL_WORKTREES",
      "NO_ACTIVE_AEF_LEASE",
      "ORIGIN_IS_GITHUB",
      "FETCH_OR_REMOTE_TRACKING_CURRENT",
      "ALL_LOCAL_BRANCH_TIPS_REACHABLE_FROM_ORIGIN"
    ],
    "delete_only_when_metadata_flag": "delete_after_project_complete"
  },
  "android_build_deletion": {
    "types": [
      "ANDROID_BUILD_TREE",
      "ANDROID_TEST_OUTPUT"
    ],
    "required": [
      "build_complete",
      "test_evidence_sealed"
    ],
    "protected_foundations": [
      "Android/Sdk",
      "/opt/android-sdk",
      "/usr/lib/jvm",
      "~/.gradle/wrapper"
    ]
  },
  "worktree_deletion": {
    "required": [
      "integration_admitted",
      "NO_ACTIVE_AEF_LEASE",
      "WORKTREE_CLEAN"
    ],
    "revoked_or_failed_default": "QUARANTINED"
  },
  "protected_absolute_prefixes": [
    "/var/lib/dial-control/secrets",
    "/var/lib/dial-control/state",
    "/var/lib/dial-control/missions",
    "/var/lib/dial-control/approvals",
    "/var/lib/dial-control/shared-memory/admitted",
    "/var/lib/dial-control/execution/receipts",
    "/var/lib/dial-control/knowledge/admission",
    "/var/lib/dial-control/knowledge/capsules",
    "/etc/dial",
    "/etc/wireguard",
    "/opt/oci-cli",
    "/usr/lib/jvm",
    "~/Android/Sdk",
    "~/.gradle/wrapper",
    "/opt/android-sdk",
    "/usr/local/android-sdk"
  ],
  "host_profiles": {
    "dial-control": {
      "mode": "FULL_STATE_AWARE",
      "allow_classes": [
        "DERIVED",
        "EPHEMERAL",
        "CACHE"
      ],
      "notes": "Protect Hermes, Project Truth, VEKL authority and owner-control state."
    },
    "dial-hermes-control": {
      "mode": "FULL_STATE_AWARE",
      "allow_classes": [
        "DERIVED",
        "EPHEMERAL",
        "CACHE"
      ]
    },
    "vekl-worker": {
      "mode": "VEKL_WORKER",
      "allow_classes": [
        "DERIVED",
        "EPHEMERAL",
        "CACHE"
      ],
      "notes": "Raw/rejected research can be collected only after admission/provenance closure."
    },
    "van-trading-core": {
      "mode": "TRADING_CONSERVATIVE",
      "allow_classes": [
        "DERIVED",
        "EPHEMERAL",
        "CACHE"
      ],
      "protected_semantics": [
        "VATI_LEDGER",
        "TRADING_DATABASE",
        "N8N_DATABASE",
        "ACTIVE_BROWSER_SESSION"
      ]
    },
    "oracle-admin": {
      "mode": "RECOVERY_ONLY",
      "allow_classes": [
        "EPHEMERAL",
        "CACHE"
      ],
      "notes": "No project repository or development workload cleanup because such workloads must not live here."
    }
  },
  "disk_pressure": {
    "informational_only_for_safety": true,
    "thresholds_percent": {
      "routine": 65,
      "cache_pressure": 75,
      "aggressive_regeneratable": 85,
      "emergency": 92
    },
    "rule": "Disk pressure may accelerate already-safe GC but never makes a protected or unproven resource deletable."
  },
  "reconciliation": {
    "event_driven_primary": true,
    "systemd_path_trigger": true,
    "fallback_timer_minutes": 30
  }
}
