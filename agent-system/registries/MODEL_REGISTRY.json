  "record": "docs/dial/final-audit/06_DEVELOPMENT_SYSTEM/DIAL_ADAPTIVE_MODEL_HARNESS_VEKL_EXECUTION_ARCHITECTURE_CANONICAL.md",
  "authority_note": "A model describes a REASONING/CODING capability, independent of the execution environment that hosts it. Entries here are SEEDS and qualification records, never a permanent hard-coding: live availability is discovered per §37 from authenticated subscriptions and normalised into this registry. An entry that discovery cannot confirm is not routable regardless of what is written here.",
  "eligibility_default": {
    "policy": "SUBSCRIPTION_PRESENCE_CONFERS_ELIGIBILITY",
    "rule": "A model confirmed present on an authorised subscription is worker-eligible at every risk class its harness and the task's security/data policy permit. DIAL does not re-prove capabilities the provider already establishes.",
    "owner_decision": "Owner overruled an earlier deny-until-qualified reading on 2026-09-13: model capabilities are known, DIAL should not make a model earn access, and performance is learned from real assigned jobs rather than from probation work.",
    "disqualifiers_are_explicit_only": [
      "MODEL_ABSENT_FROM_SUBSCRIPTION",
      "MODEL_UNAVAILABLE_OR_UNHEALTHY",
      "QUOTA_EXHAUSTED",
      "HARNESS_INCOMPATIBLE",
      "REQUIRED_CAPABILITY_NOT_DECLARED",
      "DATA_CLASS_NOT_PERMITTED",
      "RISK_CLASS_NOT_PERMITTED_BY_HARNESS",
      "OWNER_FORBADE_MODEL_OR_PROVIDER"
    ],
    "no_probation": true,
    "no_first_test_restriction": true,
    "learning_source": "ASSIGNED_JOBS"
  },
  "manager_eligibility_never_excludes_worker_eligibility": true,
  "qualification_states": [
    "PRESENT",
    "ABSENT",
    "UNAVAILABLE",
    "QUOTA_EXHAUSTED",
    "BLOCKED_BY_OWNER"
  ],
