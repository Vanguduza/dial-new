  "authority_note": "A model describes a REASONING/CODING capability, independent of the execution environment that hosts it. Entries here are SEEDS and qualification records, never a permanent hard-coding: live availability is discovered per §37 from authenticated subscriptions and normalised into this registry. An entry that discovery cannot confirm is not routable regardless of what is written here.",

  "eligibility_default": {
    "policy": "DISCOVERABLE_BY_DEFAULT_QUALIFIED_BEFORE_ROUTABLE",
    "deviation_from_document": "§6 states every model in an authorised subscription is 'worker-eligible by default, unless explicitly disqualified'. Taken literally that is allow-by-default and contradicts §38 (routing uses only models meeting qualification policy) and §65 (DISCOVERED → QUALIFYING → SHADOW_TESTED → LIMITED_TRAFFIC → QUALIFIED). DIAL fails closed everywhere else, so the deny-until-qualified reading wins: discovery WIDENS the candidate pool, only qualification GRANTS eligibility. §6's intent — do not hand-encode one Claude model and one Codex model — is fully preserved, because discovery is what populates the pool.",
    "resolved_by": "owner review 2026-09-12"
  },

  "manager_eligibility_never_excludes_worker_eligibility": true,

  "qualification_states": ["DISCOVERED", "QUALIFYING", "SHADOW_TESTED", "LIMITED_TRAFFIC", "QUALIFIED", "APPROVED", "DEGRADED", "BLOCKED", "UNAVAILABLE"],
  "routable_states": ["LIMITED_TRAFFIC", "QUALIFIED", "APPROVED"],
  "high_risk_routable_states": ["QUALIFIED", "APPROVED"],

