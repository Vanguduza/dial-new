      "promotion_requires_owner_or_authorized_design_authority": true,
      "parity_evidence_required_after_promotion": true,
      "runtime_dependency_forbidden": true,
      "automatic_dispatch": false,
      "fallback_on_stitch_failure": false,
      "invocation": "EXPLICIT_OWNER_OR_AUTHORIZED_TASK_ONLY",
      "role": "EXPLICIT_ON_DEMAND_FALLBACK"
    }
  },
  "readiness_required": true,
  "readiness_ref": "DEC-033",
  "primary_design_provider": "google-stitch",
  "automatic_design_provider": "google-stitch",
  "automatic_provider_fallback_forbidden": true,
  "figma_invocation_policy": "EXPLICIT_OWNER_OR_AUTHORIZED_TASK_ONLY"
