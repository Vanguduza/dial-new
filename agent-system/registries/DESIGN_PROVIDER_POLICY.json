  "live_qualification_required": true,
  "fixed_mcp_host": "https://stitch.googleapis.com/mcp",
  "arbitrary_host_override_forbidden": true,
  "real_screen_acceptance_required_for_integrated_claim": true,
  "frontend_contract_binding": {
    "fdep_required_for_product_experience_tasks": true,
    "design_brief_bundle_required": true,
    "change_budget_required": true,
    "design_normalizer_required": true,
    "surface_state_matrix_required": true,
    "provider_may_become_runtime_dependency": false
