{
  "schema_version": 1,
  "policy_version": "dial-aef-design-provider-4-frontend-2.0",
  "authority": "DEVELOPMENT_PROVIDER_POLICY",
  "stitch_optional": false,
  "runtime_dependency_forbidden": true,
  "provider_output_requires_quarantine": true,
  "reverse_authority_flow_forbidden": true,
  "default_enabled": true,
