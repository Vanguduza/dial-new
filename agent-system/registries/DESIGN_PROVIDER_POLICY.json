      "outage_fallback_must_preserve_acceptance": true,
      "automatic_dispatch": true,
      "roles": [
        "PRIMARY_VISUAL_DESIGN_AUTHORITY",
        "PRIMARY_INTERACTION_DESIGN_AUTHORITY",
        "PRIMARY_MOTION_ENRICHMENT_AUTHORITY"
      ],
      "phases": [
        "EXPLORE",
        "CONVERGE",
        "INTERACTION_ENRICH",
        "MOTION_ENRICH"
      ],
      "outage_behavior": "WAIT_RETRY_OR_REPORT_UNAVAILABLE_NO_PROVIDER_SUBSTITUTION"
    },
    "figma": {
      "optional": true,
      "authority_states": [
