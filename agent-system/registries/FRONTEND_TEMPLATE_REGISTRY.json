      "outputs": [
        "implementation",
        "DesignNormalizationEvidence",
        "CertificationEvidence"
      ]
    },
    {
      "template_id": "frontend.synthesize",
      "mode": "SYNTHESIZE",
      "task_classes": [
        "NEW_FRONTEND_DESIGN"
      ],
      "required_inputs": [
        "FDEP",
        "ProductDesignProfile",
        "SurfaceManifest"
      ],
      "outputs": [
        "implementation",
        "DesignNormalizationEvidence",
        "CertificationEvidence"
      ]
    },
    {
      "template_id": "frontend.enhance",
      "mode": "ENHANCE",
      "task_classes": [
        "LOCKED_DESIGN_ENHANCEMENT"
