{
  "schema_version": 1,
  "policy_id": "dial-n8n-runtime-fabric",
  "policy_version": "1.0.0",
  "authority": "SUBORDINATE_RUNTIME_POLICY",
  "naming": {
    "VEKL_N8N_CORPUS": {
      "meaning": "knowledge ABOUT workflows: pattern ingestion, sanitization, archetypes, security and capability knowledge",
      "check": "agent:vekl:n8n-corpus-check",
      "legacy_check_alias": "agent:vekl:n8n-check",
      "executes_workflows": false
    },
    "DIAL_N8N_DEV": {
      "meaning": "self-hosted development workflow runtime",
      "check": "agent:n8n-dev:qualification",
      "executes_workflows": true
    },
    "DIAL_N8N_PROD": {
      "meaning": "self-hosted production workflow runtime",
      "check": "agent:n8n-prod:qualification",
      "executes_workflows": true
    }
  },
  "corpus_projection": {
    "source_of_node_knowledge": [
      "agent-system/engineering-knowledge/automation/n8n-node-capability-map.json",
      "agent-system/engineering-knowledge/automation/n8n-security-rules.json",
      "agent-system/engineering-knowledge/automation/n8n-pattern-archetypes.json"
    ],
    "second_allowlist_forbidden": true,
    "runtime_may_be_stricter_than_corpus": true,
    "runtime_may_be_looser_than_corpus": false,
    "runtime_may_write_corpus": false
  },
  "forbidden_runtime_authorities": [
    "PRICE",
    "MONEY_STATE",
    "BENEFICIARY_ALLOCATION",
    "ACCOUNT_BALANCE",
    "GROCERY_CREDIT_TRUTH",
    "INVENTORY_TRUTH",
    "FINAL_ORDER_TRUTH",
    "IDENTITY_TRUTH",
    "ACCESS_CONTROL_TRUTH",
    "PROJECT_TRUTH"
  ],
  "permitted_runtime_roles": [
    "RECEIVE_EVENT",
    "CALL_GOVERNED_API",
    "WAIT",
    "RETRY",
    "ROUTE",
    "ENRICH",
    "NOTIFY",
    "REQUEST_APPROVAL",
    "TRIGGER_EXTERNAL_INTEGRATION",
    "AGGREGATE_WORKFLOW_EVIDENCE",
    "SCHEDULE_JOB",
    "COORDINATE_MULTI_SYSTEM_PROCESS"
  ],
  "capability_classes": [
    "HTTP",
    "DB",
    "FILE",
    "CODE",
    "AI",
    "MESSAGING",
    "CLOUD",
    "CONTROL",
    "INTEGRATION",
    "HUMAN"
  ],
  "high_risk_capabilities": [
    "SHELL_EXECUTION",
    "CODE_EXECUTION",
    "FILESYSTEM",
    "SSH",
    "DATABASE",
    "AI_AGENT",
    "MCP_CLIENT"
  ],
  "capability_class_by_capability": {
    "HTTP_RECEIVE": "HTTP",
    "HTTP_CALL": "HTTP",
    "HTTP_RESPOND": "HTTP",
    "DATABASE": "DB",
    "FILESYSTEM": "FILE",
    "CODE_EXECUTION": "CODE",
    "SHELL_EXECUTION": "CODE",
    "SSH": "CODE",
    "AI_AGENT": "AI",
    "MCP_CLIENT": "AI",
    "NOTIFY": "MESSAGING",
    "GITHUB_INTEGRATION": "INTEGRATION",
    "HUMAN_INPUT": "HUMAN",
    "SCHEDULE": "CONTROL",
    "MANUAL_TRIGGER": "CONTROL",
    "CONDITION": "CONTROL",
    "ROUTE": "CONTROL",
    "MERGE": "CONTROL",
    "WAIT": "CONTROL"
  },
  "estates": {
    "DEV": {
      "estate_id": "DIAL_N8N_DEV",
      "environment": "DEV",
      "prod_credentials_permitted": false,
      "denied_capabilities": [
        "SHELL_EXECUTION",
        "SSH"
      ],
      "approval_required_capabilities": [
        "CODE_EXECUTION",
        "FILESYSTEM",
        "DATABASE",
        "AI_AGENT",
        "MCP_CLIENT"
      ],
      "outbound_network_default": "ALLOWLIST",
      "execution_retention_days": 14
    },
    "PROD": {
      "estate_id": "DIAL_N8N_PROD",
      "environment": "PROD",
      "prod_credentials_permitted": true,
      "denied_capabilities": [
        "SHELL_EXECUTION",
        "SSH",
        "CODE_EXECUTION",
        "FILESYSTEM",
        "MCP_CLIENT"
      ],
      "approval_required_capabilities": [
        "DATABASE",
        "AI_AGENT",
        "HTTP_CALL"
      ],
      "outbound_network_default": "DENY",
      "execution_retention_days": 90
    }
  },
  "isolation_requirements": [
    "separate_database",
    "separate_encryption_key",
    "separate_credential_store",
    "separate_webhook_domain",
    "separate_service_account",
    "separate_network_policy",
    "separate_execution_retention",
    "separate_role_bindings",
    "separate_promotion_path",
    "separate_backups",
    "separate_audit_stream"
  ],
  "event_contract": {
    "envelope_version": 1,
    "required_fields": [
      "event_id",
      "event_type",
      "event_version",
      "occurred_at",
      "producer",
      "aggregate_type",
      "aggregate_id",
      "correlation_id",
      "data_class",
      "payload",
      "signature"
    ],
    "data_classes": [
      "BUSINESS",
      "OPERATIONAL",
      "DEVELOPMENT",
      "HEALTH_SENSITIVE"
    ],
    "data_classes_denied_in_workflows": [
      "HEALTH_SENSITIVE"
    ],
    "signature_algorithm": "HMAC_SHA256",
    "replay_window_seconds": 900
  },
  "retry_classes": {
    "TRANSIENT": {
      "retryable": true,
      "max_attempts": 5,
      "backoff": "EXPONENTIAL"
    },
    "RATE_LIMIT": {
      "retryable": true,
      "max_attempts": 8,
      "backoff": "EXPONENTIAL_WITH_JITTER"
    },
    "AUTH_EXPIRED": {
      "retryable": true,
      "max_attempts": 2,
      "backoff": "IMMEDIATE_AFTER_REFRESH"
    },
    "DEPENDENCY_UNAVAILABLE": {
      "retryable": true,
      "max_attempts": 5,
      "backoff": "EXPONENTIAL"
    },
    "VALIDATION_FAILURE": {
      "retryable": false,
      "max_attempts": 0,
      "backoff": "NONE"
    },
    "POLICY_DENIED": {
      "retryable": false,
      "max_attempts": 0,
      "backoff": "NONE"
    },
    "PERMANENT_BUSINESS_FAILURE": {
      "retryable": false,
      "max_attempts": 0,
      "backoff": "NONE"
    },
    "UNKNOWN": {
      "retryable": false,
      "max_attempts": 0,
      "backoff": "NONE"
    }
  },
  "never_retry": [
    "INVALID_PAYMENT_OPERATION",
    "POLICY_DENIED_ACTION",
    "MALFORMED_BUSINESS_COMMAND",
    "IRREVERSIBLE_EFFECT_WITHOUT_IDEMPOTENCY"
  ],
  "dead_letter": {
    "required_fields": [
      "execution_id",
      "workflow_id",
      "workflow_version",
      "triggering_event_id",
      "failure_class",
      "retry_count",
      "last_error",
      "correlation_id",
      "affected_aggregate",
      "business_state_mutated",
      "recommended_operator_action"
    ],
    "prod_alert_required": true
  },
  "promotion_pipeline": [
    "DRAFT",
    "STATIC_VALIDATION",
    "CORPUS_SECURITY_CHECK",
    "DEV_EXECUTION",
    "SYNTHETIC_TESTS",
    "FAILURE_PATH_TESTS",
    "IDEMPOTENCY_TEST",
    "SECRET_NETWORK_POLICY_TEST",
    "APPROVAL",
    "SIGNED_RELEASE_EXPORT",
    "PRODUCTION_IMPORT",
    "CANARY",
    "PRODUCTION_ACTIVE"
  ],
  "human_approval_required_for": [
    "SUPPLIER_ONBOARDING",
    "PRODUCTION_WORKFLOW_PROMOTION",
    "HIGH_VALUE_EXCEPTION_HANDLING",
    "UNUSUAL_REFUND_SUPPORT_PROCESS",
    "DESIGN_AUTHORITY_PROMOTION",
    "EXTERNAL_CAMPAIGN_PUBLICATION",
    "PRIVILEGED_INTEGRATION_CHANGE"
  ],
  "secrets": {
    "embedded_secrets_forbidden": true,
    "credential_store_required": true,
    "environment_specific_identity_required": true,
    "rotation_required": true,
    "log_redaction_required": true,
    "dev_prod_secret_sharing_forbidden": true
  },
  "database_policy": {
    "prefer_service_apis": true,
    "direct_read_only_permitted_with_justification": true,
    "direct_authoritative_table_mutation_forbidden": true
  },
  "rollback": {
    "mode": "DISABLE_AT_INGRESS",
    "domain_services_must_continue": true,
    "n8n_sole_source_of_business_truth_forbidden": true
  },
  "feature_flags": {
    "dev_estate_enabled": false,
    "prod_estate_enabled": false
  },
  "development_workflows": [
    "VEKL_DISCOVERY_ORCHESTRATION",
    "FRONTEND_CANDIDATE_ORCHESTRATION",
    "CI_EVIDENCE_AGGREGATION",
    "RESEARCH_HARVEST_TRACKING",
    "HERMES_NOTIFICATION"
  ],
  "production_pilots": [
    {
      "pilot_id": "SPARE_SUPPLIER_AVAILABILITY_NOTIFICATION",
      "product": "DIAL_A_SPARE",
      "authority_risk": "LOW"
    },
    {
      "pilot_id": "TECH_APPOINTMENT_NOTIFICATION",
      "product": "DIAL_A_TECH",
      "authority_risk": "LOW"
    },
    {
      "pilot_id": "GROCERIES_ROUND_REMINDER",
      "product": "DIAL_GROCERIES",
      "authority_risk": "LOW"
    },
    {
      "pilot_id": "LOGISTICS_DELIVERY_STATUS_NOTIFICATION",
      "product": "DIAL_LOGISTICS",
      "authority_risk": "LOW"
    },
    {
      "pilot_id": "CARE_SERVICE_DUE_REMINDER",
      "product": "DIAL_CARE",
      "authority_risk": "LOW"
    }
  ],
  "money_sensitive_workflows_deferred": true,
  "tenancy": {
    "expected_owner": "DIAL",
    "expected_tenant_id": "DIAL",
    "third_party_state_sharing_forbidden": true,
    "required_descriptor_fields": [
      "tenant_id",
      "estate_owner",
      "database_host",
      "database"
    ],
    "third_party_isolation_fields": [
      "database_identity",
      "encryption_key_id",
      "credential_store",
      "service_account",
      "role_binding",
      "backup_target",
      "audit_stream"
    ]
  }
}
