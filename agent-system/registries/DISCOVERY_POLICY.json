{
  "schema_version": 1,
  "policy_id": "dial-vekl-open-world-discovery",
  "policy_version": "1.0.0",
  "authority": "SUBORDINATE_DISCOVERY_POLICY",
  "extends_source_registry": "agent-system/engineering-knowledge/registries/ENGINEERING_RESOURCE_SOURCE_REGISTRY.json",
  "second_trust_vocabulary_forbidden": true,
  "invariants": [
    "discovery_is_not_trust",
    "discovery_is_not_execution",
    "discovery_is_not_activation",
    "trial_success_never_promotes_trust_tier",
    "open_world_discovery_cannot_mint_T0",
    "official_tier_requires_official_provenance",
    "candidate_material_is_never_authority",
    "sandbox_holds_no_dial_credential",
    "executable_activation_requires_exact_version_pin"
  ],
  "lifecycle_states": [
    "DISCOVERED",
    "TRIAGED",
    "INVESTIGATING",
    "EXPERIMENTAL",
    "QUALIFIED",
    "ADMITTED",
    "REJECTED",
    "SUPERSEDED",
    "DEPRECATED",
    "QUARANTINED"
  ],
  "terminal_states": ["REJECTED", "SUPERSEDED", "DEPRECATED"],
  "admitted_states": ["ADMITTED"],
  "authority_bearing_states": ["ADMITTED"],
  "lifecycle_transitions": {
    "DISCOVERED": ["TRIAGED", "REJECTED", "QUARANTINED"],
    "TRIAGED": ["INVESTIGATING", "REJECTED", "QUARANTINED"],
    "INVESTIGATING": ["EXPERIMENTAL", "QUALIFIED", "REJECTED", "QUARANTINED"],
    "EXPERIMENTAL": ["QUALIFIED", "REJECTED", "QUARANTINED"],
    "QUALIFIED": ["ADMITTED", "REJECTED", "QUARANTINED"],
    "ADMITTED": ["SUPERSEDED", "DEPRECATED", "QUARANTINED"],
    "QUARANTINED": ["INVESTIGATING", "REJECTED"],
    "REJECTED": [],
    "SUPERSEDED": [],
    "DEPRECATED": []
  },
  "transition_evidence_required": {
    "TRIAGED": ["triage_note"],
    "INVESTIGATING": ["provenance_probe"],
    "EXPERIMENTAL": ["trial_manifest_hash"],
    "QUALIFIED": ["qualification_manifest_hash"],
    "ADMITTED": ["qualification_manifest_hash", "owner_or_delegated_authority"],
    "REJECTED": ["disposition_reason"],
    "QUARANTINED": ["disposition_reason"],
    "SUPERSEDED": ["superseded_by"],
    "DEPRECATED": ["disposition_reason"]
  },
  "trust_tiers": [
    "T0_DIAL_PROJECT",
    "T1_OFFICIAL",
    "T2_MAINTAINER_COMMUNITY",
    "T3_COMMUNITY_CORROBORATION",
    "T4_COMMUNITY_SIGNAL"
  ],
  "default_provisional_tier": "T4_COMMUNITY_SIGNAL",
  "tier_assignment_rules": {
    "T0_DIAL_PROJECT": {
      "open_world_assignable": false,
      "reason": "reserved for DIAL Project Truth and DIAL-controlled canonical resources"
    },
    "T1_OFFICIAL": {
      "open_world_assignable": true,
      "requires_all": ["official_publisher_verified", "canonical_locator_on_publisher_domain_or_repo"],
      "trial_success_sufficient": false
    },
    "T2_MAINTAINER_COMMUNITY": {
      "open_world_assignable": true,
      "requires_all": ["maintainer_identity_linked"],
      "trial_success_sufficient": false
    },
    "T3_COMMUNITY_CORROBORATION": {
      "open_world_assignable": true,
      "requires_all": ["independent_corroboration_count_at_least_2"],
      "trial_success_sufficient": false
    },
    "T4_COMMUNITY_SIGNAL": {
      "open_world_assignable": true,
      "requires_all": [],
      "trial_success_sufficient": false
    }
  },
  "authority_role_by_tier": {
    "T0_DIAL_PROJECT": "AUTHORITY",
    "T1_OFFICIAL": "AUTHORITY",
    "T2_MAINTAINER_COMMUNITY": "CORROBORATION",
    "T3_COMMUNITY_CORROBORATION": "CORROBORATION",
    "T4_COMMUNITY_SIGNAL": "SIGNAL"
  },
  "trigger_classes": [
    { "trigger_id": "REACTIVE", "description": "explicit engineering task with insufficient admitted coverage", "may_reprioritise_development_plan": false },
    { "trigger_id": "GAP_DRIVEN", "description": "low coverage, stale evidence or missing resource class", "may_reprioritise_development_plan": false },
    { "trigger_id": "FRESHNESS", "description": "admitted knowledge exceeded its freshness TTL", "may_reprioritise_development_plan": false },
    { "trigger_id": "COMPETITIVE_REPLACEMENT", "description": "known resource deprecated, blocked, costly or underperforming", "may_reprioritise_development_plan": false },
    { "trigger_id": "HORIZON_SCAN", "description": "bounded scheduled scan of high-velocity domains", "may_reprioritise_development_plan": false, "scheduled": true }
  ],
  "source_adapters": [
    { "adapter_id": "WEB_SEARCH", "authority_by_default": false, "max_provisional_tier": "T4_COMMUNITY_SIGNAL" },
    { "adapter_id": "GITHUB_SEARCH", "authority_by_default": false, "max_provisional_tier": "T4_COMMUNITY_SIGNAL" },
    { "adapter_id": "PACKAGE_REGISTRY", "authority_by_default": false, "max_provisional_tier": "T2_MAINTAINER_COMMUNITY" },
    { "adapter_id": "OFFICIAL_DOC_INDEX", "authority_by_default": false, "max_provisional_tier": "T1_OFFICIAL" },
    { "adapter_id": "RELEASE_FEED", "authority_by_default": false, "max_provisional_tier": "T1_OFFICIAL" },
    { "adapter_id": "ISSUE_DISCUSSION", "authority_by_default": false, "max_provisional_tier": "T2_MAINTAINER_COMMUNITY" },
    { "adapter_id": "SECURITY_ADVISORY_FEED", "authority_by_default": false, "max_provisional_tier": "T1_OFFICIAL" },
    { "adapter_id": "PLUGIN_MCP_DIRECTORY", "authority_by_default": false, "max_provisional_tier": "T3_COMMUNITY_CORROBORATION" },
    { "adapter_id": "CURATED_TECHNICAL_LIST", "authority_by_default": false, "max_provisional_tier": "T4_COMMUNITY_SIGNAL" },
    { "adapter_id": "DESIGN_RESOURCE_INDEX", "authority_by_default": false, "max_provisional_tier": "T3_COMMUNITY_CORROBORATION" },
    { "adapter_id": "PROMPT_RESOURCE_INDEX", "authority_by_default": false, "max_provisional_tier": "T4_COMMUNITY_SIGNAL" },
    { "adapter_id": "COMMUNITY_SIGNAL", "authority_by_default": false, "max_provisional_tier": "T4_COMMUNITY_SIGNAL" }
  ],
  "sensitive_outbound_denylist": [
    "SECRET",
    "API_KEY",
    "SERVICE_ROLE_KEY",
    "PAYMENT_DETAIL",
    "CUSTOMER_IDENTIFIER",
    "PRIVATE_ORDER_DATA",
    "IDENTIFIABLE_HEALTH_INFORMATION",
    "OWNER_PRIVATE_CREDENTIAL",
    "PRODUCTION_DATABASE_CONTENT"
  ],
  "sandbox_policy": {
    "required": true,
    "network_default": "DENY",
    "egress_allowlist_required_when_network_enabled": true,
    "forbidden_environment_keys": [
      "SUPABASE_SERVICE_ROLE_KEY",
      "SUPABASE_ANON_KEY",
      "DIAL_OWNER_TOKEN",
      "OPENAI_API_KEY",
      "ANTHROPIC_API_KEY",
      "GOOGLE_API_KEY",
      "STRIPE_SECRET_KEY",
      "PAYNOW_INTEGRATION_KEY",
      "ORACLE_CONTROL_TOKEN",
      "HERMES_CONTROL_TOKEN",
      "GITHUB_TOKEN",
      "WHATSAPP_ACCESS_TOKEN"
    ],
    "forbidden_environment_key_patterns": [
      "(?i)secret",
      "(?i)token",
      "(?i)api[_-]?key",
      "(?i)password",
      "(?i)credential",
      "(?i)private[_-]?key",
      "(?i)service[_-]?role"
    ],
    "limits": {
      "max_wall_clock_seconds": 300,
      "max_cpu_seconds": 120,
      "max_memory_mb": 1024,
      "max_disk_mb": 512,
      "max_processes": 64
    },
    "write_paths_forbidden": [
      "agent-system/canon",
      "docs/project-state",
      "agent-system/registries",
      "agent-system/engineering-knowledge/registries"
    ],
    "trial_result_manifest_required": true
  },
  "executable_admission_pipeline": [
    "DISCOVERY",
    "IMMUTABLE_IDENTITY_RESOLUTION",
    "EXACT_REVISION_PIN",
    "LICENSE_REVIEW",
    "PROVENANCE_VERIFICATION",
    "STATIC_INSPECTION",
    "DEPENDENCY_SECURITY_REVIEW",
    "ISOLATED_EXECUTION",
    "TASK_SPECIFIC_EVALUATION",
    "DONOR_SECURITY_EVAL_PROVENANCE_RECORD",
    "QUALIFICATION",
    "REGISTRY_ADMISSION",
    "GOVERNED_ACTIVATION_ELIGIBILITY"
  ],
  "reassessment": {
    "states": ["CURRENT", "STALE", "SUPERSEDED", "DEPRECATED", "REVOKED"],
    "may_rewrite_project_truth": false,
    "may_change_programme_priority": false,
    "default_review_interval_hours": 720
  },
  "feature_flags": {
    "discovery_adapters_enabled": false,
    "executable_trials_enabled": false,
    "horizon_scan_enabled": false
  },
  "rollback": {
    "mode": "DISABLE_ADAPTERS_KEEP_EVIDENCE",
    "discovery_evidence_deletion_forbidden": true
  }
}
