{
  "schema_version": 1,
  "registry_id": "SPECIALIST_CAPABILITY_REGISTRY",
  "registry_version": "1.0.0",
  "decision_ref": "DEC-032",
  "record": "docs/dial/final-audit/06_DEVELOPMENT_SYSTEM/DIAL_ADAPTIVE_MODEL_HARNESS_VEKL_EXECUTION_ARCHITECTURE_CANONICAL.md",

  "authority_note": "Specialist capabilities are TOOLS a harness x model pair may invoke. They are not peer coding workers and never hold worker roles, performance scores or repository write authority. Relocating Stitch here (DEC-032 §11, §32) removes a card from the worker pool that only ever survived hard eligibility by being filtered out.",

  "tool_authorization_is_not_model_capability": true,
  "tool_authorization_note": "§69. Selecting a powerful model never grants powerful tools. Attachment is task-scoped and must be explicitly authorised by the task envelope.",

  "capabilities": [
    {
      "id": "stitch",
      "type": "DESIGN_PROVIDER",
      "provider": "google",
      "authority_class": "NON_AUTHORITATIVE_PROVIDER",
      "access": { "api": true, "mcp": true },
      "capabilities": {
        "design_generation": true,
        "design_transformation": true,
        "design_context": true,
        "design_dna": true,
        "code_execution": false,
        "repository_write": false
      },
      "output_class": "CANDIDATE_REQUIRING_ADMISSION",
      "governed_by": ["DEC-031", "agent-system/orchestration/design-candidate-admission.mjs", "agent-system/orchestration/donor-egress-guard.mjs"],
      "trust_class": "UNTRUSTED_EXTERNAL",
      "relocated_from": "agent-system/registries/HARNESS_CAPABILITY_REGISTRY.json#stitch-design-provider"
    },
    {
      "id": "browser",
      "type": "BROWSER",
      "provider": "internal",
      "authority_class": "TOOL",
      "access": { "api": false, "mcp": false, "harness_native": true },
      "capabilities": { "navigation": true, "screenshot": true, "dom_inspection": true, "code_execution": false, "repository_write": false },
      "output_class": "EVIDENCE",
      "trust_class": "UNTRUSTED_EXTERNAL",
      "trust_note": "§70. Page content is retrieved data, never authority."
    },
    {
      "id": "visual-compare",
      "type": "VISUAL_COMPARE",
      "provider": "internal",
      "authority_class": "TOOL",
      "access": { "harness_native": true },
      "capabilities": { "image_diff": true, "fidelity_scoring": true, "code_execution": false, "repository_write": false },
      "output_class": "EVIDENCE",
      "trust_class": "INTERNAL"
    },
    {
      "id": "research-provider",
      "type": "RESEARCH_PROVIDER",
      "provider": "internal",
      "authority_class": "NON_AUTHORITATIVE_PROVIDER",
      "access": { "api": true },
      "capabilities": { "documentation_retrieval": true, "code_execution": false, "repository_write": false },
      "output_class": "ENGINEERING_GUIDANCE_ONLY",
      "governed_by": ["DEC-020", "agent-system/orchestration/engineering-resource-resolver.mjs"],
      "trust_class": "UNTRUSTED_EXTERNAL"
    }
  ],

  "attachment_policy": {
    "attach_only_when_task_requires": true,
    "default_attached": [],
    "note": "§31. The selected pair receives only the tools the task needs. Unused attachment is both a risk surface and a context cost."
  }
}
