{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "feature_id",
      "module",
      "outcome",
      "owner",
      "status",
      "current_gate",
      "realization_ref",
      "donor_refs",
      "client_exposure",
      "app_families",
      "support_profile"
    ],
    "properties": {
      "feature_id": {
        "type": "string",
        "pattern": "^[A-Z]+-F[0-9]{3}$"
      },
      "module": {
        "type": "string"
      },
      "outcome": {
        "type": "string"
      },
      "owner": {
        "type": "string"
      },
      "status": {
        "enum": [
          "SPECIFIED",
          "DESIGN_CLOSED",
          "BUILDABLE",
          "CODE_PRESENT",
          "DOMAIN_TESTED",
          "INTEGRATION_GREEN",
          "STAGING_GREEN",
          "CERTIFIED_DORMANT",
          "ACTIVATION_BLOCKERS_GREEN",
          "ACTIVE"
        ]
      },
      "current_gate": {
        "type": "string",
        "enum": [
          "SPECIFIED",
          "DESIGN_CLOSED",
          "BUILDABLE",
          "CODE_PRESENT",
          "DOMAIN_TESTED",
          "INTEGRATION_GREEN",
          "STAGING_GREEN",
          "CERTIFIED_DORMANT",
          "ACTIVATION_BLOCKERS_GREEN",
          "ACTIVE"
        ]
      },
      "code_paths": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "test_paths": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "evidence_refs": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "kind"
          ],
          "additionalProperties": false,
          "properties": {
            "kind": {
              "enum": [
                "ACCEPTANCE_CONTRACT",
                "TEST",
                "DOC",
                "CI_RUN",
                "LOCAL_RUN_NOTE"
              ]
            },
            "ref": {
              "type": "string",
              "minLength": 1
            },
            "note": {
              "type": "string",
              "minLength": 1
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "kind": {
                    "enum": [
                      "ACCEPTANCE_CONTRACT",
                      "TEST",
                      "DOC",
                      "CI_RUN"
                    ]
                  }
                }
              },
              "then": {
                "required": [
                  "kind",
                  "ref"
                ]
              }
            },
            {
              "if": {
                "properties": {
                  "kind": {
                    "const": "LOCAL_RUN_NOTE"
                  }
                }
              },
              "then": {
                "required": [
                  "kind",
                  "note"
                ],
                "not": {
                  "required": [
                    "ref"
                  ]
                }
              }
            }
          ]
        }
      },
      "realization_ref": {
        "type": "string"
      },
      "client_exposure": {
        "type": "string"
      },
      "app_families": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "support_profile": {
        "type": "string"
      }
    }
  }
}
