{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DIAL Engineering Skill",
  "type": "object",
  "required": [
    "schema_version",
    "skill_id",
    "provider",
    "authority",
    "approval_state",
    "task_classes",
    "forbidden_effects"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "skill_id": {
      "type": "string",
      "minLength": 3
    },
    "display_name": {
      "type": "string"
    },
    "provider": {
      "type": "string"
    },
    "upstream_repo": {
      "type": [
        "string",
        "null"
      ]
    },
    "research_reference_commit": {
      "type": [
        "string",
        "null"
      ]
    },
    "production_pin": {
      "type": [
        "string",
        "null"
      ]
    },
    "source_path": {
      "type": [
        "string",
        "null"
      ]
    },
    "content_hash": {
      "type": [
        "string",
        "null"
      ]
    },
    "license": {
      "type": [
        "string",
        "null"
      ]
    },
    "authority": {
      "const": "ENGINEERING_GUIDANCE_ONLY"
    },
    "approval_state": {
      "enum": [
        "DISCOVERED",
        "FETCHED_PINNED",
        "QUARANTINED",
        "LICENSE_VERIFIED",
        "STATIC_SCAN_PASSED",
        "DIAL_CONFLICT_REVIEWED",
        "EVAL_PASSED",
        "APPROVED",
        "ACTIVE",
        "SUSPENDED_PENDING_REVIEW",
        "SUPERSEDED",
        "DEPRECATED",
        "REVOKED"
      ]
    },
    "risk_class": {
      "enum": [
        "LOW",
        "MEDIUM",
        "HIGH",
        "CRITICAL"
      ]
    },
    "task_classes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "eligible_modules": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "path_triggers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "forbidden_effects": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "requires_tools": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "conflict_tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "eval_suite": {
      "type": [
        "string",
        "null"
      ]
    },
    "snapshot_rel": {
      "type": [
        "string",
        "null"
      ]
    },
    "runtime_name": {
      "type": [
        "string",
        "null"
      ]
    },
    "last_verified_at": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": true
}
