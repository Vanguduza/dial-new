{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DIAL Engineering Research Forecast",
  "type": "object",
  "required": [
    "schema_version",
    "forecast_horizon",
    "items"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "forecast_horizon": {
      "type": "string"
    },
    "items": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "required": [
          "objective",
          "task_classes",
          "technologies",
          "research_questions",
          "preferred_source_ids",
          "search_queries"
        ],
        "properties": {
          "feature_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "objective": {
            "type": "string"
          },
          "task_classes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "technologies": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "research_questions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "preferred_source_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "search_queries": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "risks": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "exclusions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
