{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DIAL Engineering Resource",
  "type": "object",
  "required": [
    "resource_id",
    "name",
    "source_id",
    "resource_class",
    "authority",
    "status",
    "activation_mode",
    "locator",
    "task_classes",
    "forbidden_effects"
  ],
  "properties": {
    "resource_id": {
      "type": "string",
      "minLength": 3
    },
    "name": {
      "type": "string"
    },
    "source_id": {
      "type": "string"
    },
    "resource_class": {
      "enum": [
        "OFFICIAL_DOC",
        "REPOSITORY",
        "RELEASE_NOTES",
        "ISSUE_DISCUSSION",
        "FORUM_QA",
        "SECURITY_ADVISORY",
        "PACKAGE_REGISTRY",
        "SKILL",
        "PLUGIN",
        "TOOL",
        "MCP_SERVER",
        "RULESET",
        "HOOK",
        "WORKFLOW_LOOP",
        "EXAMPLE_REFERENCE"
      ]
    },
    "authority": {
      "enum": [
        "PROJECT_LOCAL_ENGINEERING_POLICY",
        "ENGINEERING_GUIDANCE_ONLY",
        "COMMUNITY_SIGNAL_ONLY"
      ]
    },
    "status": {
      "enum": [
        "DISCOVERED",
        "DISCOVERY_APPROVED",
        "REFERENCE_APPROVED",
        "POLICY_APPROVED_CONDITIONAL",
        "APPROVED",
        "ACTIVE",
        "SUSPENDED",
        "REVOKED"
      ]
    },
    "activation_mode": {
      "enum": [
        "REFERENCE_ONLY",
        "CORROBORATION_ONLY",
        "DISCOVERY_ONLY",
        "READ_ONLY_TOOL",
        "EXECUTABLE_CAPABILITY",
        "PROCESS_RULE"
      ]
    },
    "locator": {
      "type": "string"
    },
    "task_classes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "technologies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "keywords": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "forbidden_effects": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "requires_tools": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "seed_urls": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "repository": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
