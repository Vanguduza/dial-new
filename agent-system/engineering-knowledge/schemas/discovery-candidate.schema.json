{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dial.local/schemas/discovery-candidate.schema.json",
  "title": "DiscoveryCandidateRecord",
  "description": "An open-world discovery candidate. Never authority. Trust tier reuses the existing VEKL source vocabulary; lifecycle_state is an orthogonal evaluation axis.",
  "type": "object",
  "required": [
    "schema_version",
    "candidate_id",
    "canonical_locator",
    "discovered_at",
    "discovered_by",
    "source_adapter",
    "trigger_class",
    "lifecycle_state",
    "provisional_trust_tier",
    "claimed_resource_classes",
    "claimed_task_classes",
    "provenance",
    "safety",
    "evidence_refs",
    "history",
    "authority"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "candidate_id": { "type": "string", "pattern": "^DISC-[0-9a-f]{24}$" },
    "canonical_locator": { "type": "string", "minLength": 3 },
    "identity_key": { "type": "string", "minLength": 3 },
    "discovered_at": { "type": "string" },
    "discovered_by": { "type": "string" },
    "originating_task": { "type": ["string", "null"] },
    "query_hash": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
    "source_adapter": { "type": "string" },
    "trigger_class": { "enum": ["REACTIVE", "GAP_DRIVEN", "FRESHNESS", "COMPETITIVE_REPLACEMENT", "HORIZON_SCAN"] },
    "lifecycle_state": {
      "enum": ["DISCOVERED", "TRIAGED", "INVESTIGATING", "EXPERIMENTAL", "QUALIFIED", "ADMITTED", "REJECTED", "SUPERSEDED", "DEPRECATED", "QUARANTINED"]
    },
    "provisional_trust_tier": {
      "enum": ["T1_OFFICIAL", "T2_MAINTAINER_COMMUNITY", "T3_COMMUNITY_CORROBORATION", "T4_COMMUNITY_SIGNAL"]
    },
    "claimed_resource_classes": { "type": "array", "items": { "type": "string" } },
    "claimed_task_classes": { "type": "array", "items": { "type": "string" } },
    "provenance": {
      "type": "object",
      "required": ["publisher_identity", "official_publisher_verified", "maintainer_identity_linked", "independent_corroboration_count"],
      "properties": {
        "publisher_identity": { "type": ["string", "null"] },
        "repository_url": { "type": ["string", "null"] },
        "exact_revision": { "type": ["string", "null"] },
        "package_version": { "type": ["string", "null"] },
        "release_tag": { "type": ["string", "null"] },
        "license": { "type": ["string", "null"] },
        "official_publisher_verified": { "type": "boolean" },
        "maintainer_identity_linked": { "type": "boolean" },
        "independent_corroboration_count": { "type": "integer", "minimum": 0 }
      }
    },
    "safety": {
      "type": "object",
      "required": ["executable_content_detected", "sensitive_data_allowed", "network_trial_allowed"],
      "properties": {
        "executable_content_detected": { "type": "boolean" },
        "sensitive_data_allowed": { "const": false },
        "network_trial_allowed": { "type": "boolean" }
      }
    },
    "evidence_refs": { "type": "array", "items": { "type": "string" } },
    "disposition_reason": { "type": ["string", "null"] },
    "superseded_by": { "type": ["string", "null"] },
    "admitted_resource_id": { "type": ["string", "null"] },
    "admitted_source_id": { "type": ["string", "null"] },
    "history": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/transition" }
    },
    "authority": { "const": "NON_AUTHORITATIVE_DISCOVERY_CANDIDATE" },
    "candidate_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  },
  "$defs": {
    "transition": {
      "type": "object",
      "title": "DiscoveryLifecycleTransition",
      "required": ["from_state", "to_state", "at", "actor", "reason"],
      "properties": {
        "from_state": { "type": ["string", "null"] },
        "to_state": { "type": "string" },
        "at": { "type": "string" },
        "actor": { "type": "string" },
        "reason": { "type": "string" },
        "evidence_refs": { "type": "array", "items": { "type": "string" } },
        "transition_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    }
  }
}
