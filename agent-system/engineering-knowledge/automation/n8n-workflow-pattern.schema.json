{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DIAL VEKL Workflow Pattern Descriptor",
  "type": "object",
  "required": [
    "schema_version",
    "pattern_lineage_id",
    "pattern_revision_hash",
    "archetype",
    "knowledge_polarity",
    "authority",
    "executable",
    "runtime_compatible",
    "compatibility",
    "capabilities",
    "required_controls",
    "normalized_flow",
    "source_support"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "pattern_lineage_id": {
      "type": "string",
      "pattern": "^n8n-pattern-[a-f0-9]{32}$"
    },
    "pattern_revision_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "archetype": {
      "type": "string"
    },
    "knowledge_polarity": {
      "enum": [
        "POSITIVE_PATTERN",
        "ANTI_PATTERN"
      ]
    },
    "authority": {
      "const": "REFERENCE_ONLY"
    },
    "executable": {
      "const": false
    },
    "runtime_compatible": {
      "const": false
    },
    "compatibility": {
      "type": "object"
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "required_controls": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "normalized_flow": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "source_support": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  },
  "additionalProperties": true
}
