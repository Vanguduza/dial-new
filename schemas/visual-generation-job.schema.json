{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dial.example/schemas/visual-generation-job.schema.json",
  "title": "VisualGenerationJob",
  "type": "object",
  "required": ["visualFamilyId", "make", "model", "generation", "bodyStyle", "visualPhase", "yearFrom", "references", "provenance", "enabledCategories", "fitmentMapping", "explodedViewPolicy"],
  "properties": {
    "visualFamilyId": { "type": "string", "pattern": "^VF-[A-Z0-9-]+$" },
    "make": { "type": "string", "minLength": 1 },
    "model": { "type": "string", "minLength": 1 },
    "generation": { "type": "string", "minLength": 1 },
    "bodyStyle": { "type": "string", "minLength": 1 },
    "visualPhase": { "type": "string", "minLength": 1 },
    "yearFrom": { "type": "integer", "minimum": 1900 },
    "yearTo": { "type": ["integer", "null"] },
    "references": { "type": "object", "required": ["frontThreeQuarter"], "properties": { "frontThreeQuarter": { "type": "string", "minLength": 1 } } },
    "provenance": { "type": "object" },
    "enabledCategories": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^VC-[A-Z]+$" }, "uniqueItems": true },
    "fitmentMapping": { "$ref": "./visual-epc-mapping.schema.json" },
    "explodedViewPolicy": {
      "type": "object",
      "required": ["expectedWheelPositions", "tyresPerPosition", "looseSpareTyres"],
      "properties": {
        "expectedWheelPositions": { "type": "integer", "minimum": 2, "maximum": 12 },
        "tyresPerPosition": {
          "type": "object",
          "minProperties": 2,
          "additionalProperties": { "type": "integer", "minimum": 0, "maximum": 2 }
        },
        "looseSpareTyres": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "developmentMode": { "type": "boolean", "default": false }
  },
  "additionalProperties": true
}
