[
  {
    "role_key": "BU_FINANCE_VIEWER",
    "name": "Business Unit Finance Viewer",
    "permissions": [
      "finance.accounts.read",
      "finance.journals.read",
      "finance.transactions.read",
      "finance.exports.create"
    ],
    "constraints": [
      "business-unit scoped",
      "no mutation"
    ],
    "position_default": true
  },
  {
    "role_key": "BU_FINANCE_ANALYST",
    "name": "Business Unit Finance Analyst",
    "permissions": [
      "finance.accounts.read",
      "finance.journals.read",
      "finance.reconciliation.review",
      "finance.exports.create"
    ],
    "constraints": [
      "business-unit/cost-centre scoped",
      "cannot approve own adjustments"
    ],
    "position_default": true
  },
  {
    "role_key": "BU_FINANCE_CONTROLLER",
    "name": "Business Unit Finance Controller",
    "permissions": [
      "finance.accounts.read",
      "finance.journals.read",
      "finance.reconciliation.resolve",
      "finance.adjustment.request",
      "returns.review"
    ],
    "constraints": [
      "business-unit scoped",
      "adjustment approval subject to DoA/SoD"
    ],
    "position_default": true
  },
  {
    "role_key": "PETTY_CASH_REQUESTER",
    "name": "Petty Cash Requester",
    "permissions": [
      "petty_cash.requisition.create",
      "petty_cash.requisition.submit",
      "petty_cash.requisition.read_own"
    ],
    "constraints": [
      "BU/site/cost-centre scoped",
      "cannot final-approve own request"
    ],
    "position_default": true
  },
  {
    "role_key": "PETTY_CASH_APPROVER",
    "name": "Petty Cash Approver",
    "permissions": [
      "petty_cash.requisition.read",
      "petty_cash.requisition.approve",
      "petty_cash.requisition.reject"
    ],
    "constraints": [
      "threshold/currency/BU scoped",
      "cannot approve own request",
      "step-up/four-eyes above configured threshold"
    ],
    "position_default": true
  },
  {
    "role_key": "PETTY_CASH_RELEASE",
    "name": "Petty Cash Funding Release",
    "permissions": [
      "petty_cash.requisition.release",
      "finance.transfer.create"
    ],
    "constraints": [
      "approved requisition only",
      "eligible settled source account",
      "SoD from requester"
    ],
    "position_default": true
  },
  {
    "role_key": "PETTY_CASH_CUSTODIAN",
    "name": "Petty Cash Custodian",
    "permissions": [
      "petty_cash.custody.acknowledge",
      "petty_cash.voucher.create",
      "petty_cash.count.create",
      "petty_cash.balance.read"
    ],
    "constraints": [
      "assigned float/site only",
      "cannot approve own unexplained variance"
    ],
    "position_default": true
  },
  {
    "role_key": "RETURNS_REVIEWER",
    "name": "Returns & Refunds Reviewer",
    "permissions": [
      "returns.read",
      "refund.request.review",
      "returns_journal.read"
    ],
    "constraints": [
      "cannot execute refund without separate money authority where policy requires"
    ],
    "position_default": true
  },
  {
    "role_key": "REFUND_APPROVER",
    "name": "Refund Approver",
    "permissions": [
      "refund.approve",
      "refund.reject"
    ],
    "constraints": [
      "BU/currency/amount threshold",
      "must reference approved return/RCE/business rule",
      "cannot approve own exceptional adjustment"
    ],
    "position_default": true
  },
  {
    "role_key": "PAYMENT_RECONCILER",
    "name": "Payment Reconciler",
    "permissions": [
      "payments.provider_statement.read",
      "payments.reconciliation.match",
      "payments.reconciliation.exception.create"
    ],
    "constraints": [
      "cannot alter original provider event",
      "adjustments require separate authority"
    ],
    "position_default": true
  },
  {
    "role_key": "TREASURY_SETTLEMENT",
    "name": "Treasury Settlement Operator",
    "permissions": [
      "provider_settlement.import",
      "provider_settlement.reconcile",
      "cash_deposit.record",
      "bank_reconciliation.read"
    ],
    "constraints": [
      "legal-entity/treasury scoped",
      "release/adjustment approval may require four-eyes"
    ],
    "position_default": true
  },
  {
    "role_key": "FINANCE_AUDITOR",
    "name": "Finance Auditor",
    "permissions": [
      "finance.accounts.read",
      "finance.journals.read",
      "finance.audit.read",
      "finance.exports.create",
      "petty_cash.count.observe"
    ],
    "constraints": [
      "read-only except audit observations"
    ],
    "position_default": true
  }
]
