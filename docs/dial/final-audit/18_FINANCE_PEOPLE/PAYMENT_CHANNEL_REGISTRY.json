[
  {
    "channel_id": "CASH",
    "display_name": "Cash",
    "kind": "PHYSICAL_TENDER",
    "currencies": "configured per business unit/location; running balances kept per currency",
    "confirmation_authority": "authorized DIAL cashier/courier/custodian cash receipt + count/custody evidence",
    "settlement_authority": "cash handover/deposit/reconciliation",
    "customer_action": "Pay cash at approved counter/handoff/COD point when allowed.",
    "provider_external_endpoints": [],
    "dial_endpoints": [
      {
        "method": "POST",
        "path": "/api/v1/payments/intents",
        "purpose": "Create canonical PaymentIntent with channel eligibility."
      },
      {
        "method": "POST",
        "path": "/api/v1/payments/{paymentIntentRef}/cash/prepare",
        "purpose": "Create cash collection instruction/token and assigned collection context."
      },
      {
        "method": "POST",
        "path": "/api/v1/payments/{paymentIntentRef}/cash/receive",
        "purpose": "Authorized collector records physical tender, currency, amount, receipt evidence."
      },
      {
        "method": "POST",
        "path": "/api/v1/payments/{paymentIntentRef}/cash/confirm-count",
        "purpose": "Second count/confirmation when policy requires."
      },
      {
        "method": "POST",
        "path": "/api/v1/cash-sessions",
        "purpose": "Open cashier/courier cash custody session."
      },
      {
        "method": "POST",
        "path": "/api/v1/cash-sessions/{sessionRef}/handover",
        "purpose": "Transfer cash custody to branch/cashier."
      },
      {
        "method": "POST",
        "path": "/api/v1/cash-sessions/{sessionRef}/close",
        "purpose": "Count and close session; identify variance."
      },
      {
        "method": "POST",
        "path": "/api/v1/cash-deposits",
        "purpose": "Record bank/treasury deposit from authorized cash holdings."
      },
      {
        "method": "POST",
        "path": "/api/v1/cash-variances/{varianceRef}/resolve",
        "purpose": "Approved cash over/short resolution."
      }
    ],
    "provider_states": [],
    "dial_state_mapping": {
      "COLLECTION_PREPARED": "ACTION_REQUIRED",
      "CASH_RECEIVED": "CONFIRMED",
      "HANDOVER_PENDING": "CONFIRMED",
      "DEPOSITED": "SETTLED",
      "VOIDED": "CANCELLED",
      "VARIANCE": "EXCEPTION"
    },
    "posting_rule": "Cash receipt and later handover/deposit are separate accounting/custody events. Never treat a physical collection as bank settlement.",
    "eventualities": [
      "customer pays wrong amount",
      "wrong currency",
      "counterfeit/suspect cash",
      "collector has no permission",
      "cash lost/stolen",
      "over/short count",
      "COD customer unavailable",
      "duplicate receipt",
      "cash received but device offline",
      "handover dispute",
      "bank deposit mismatch"
    ]
  },
  {
    "channel_id": "ECOCASH_DIRECT",
    "display_name": "EcoCash Direct USSD Push",
    "kind": "MOBILE_MONEY_DIRECT",
    "currencies": "provider/account configuration",
    "confirmation_authority": "EcoCash authenticated webhook/status response; customer USSD confirmation alone in the DIAL UI is not authority",
    "settlement_authority": "EcoCash merchant settlement/reconciliation",
    "customer_action": "DIAL initiates a Push Transaction to the customer's EcoCash number; customer confirms through EcoCash USSD.",
    "provider_external_endpoints": [
      {
        "name": "OAuth/token",
        "status": "BIND_FROM_AUTHENTICATED_ECOCASH_DEVELOPER_PORTAL",
        "note": "Public portal states OAuth 2.0 is used; exact production path is configuration, not guessed."
      },
      {
        "name": "Push/merchant payment initiation",
        "status": "BIND_FROM_AUTHENTICATED_ECOCASH_DEVELOPER_PORTAL",
        "note": "EcoCash merchant terms define Push Transaction as merchant-initiated payment sent through USSD for customer confirmation."
      },
      {
        "name": "Transaction query/status",
        "status": "BIND_FROM_AUTHENTICATED_ECOCASH_DEVELOPER_PORTAL"
      },
      {
        "name": "Webhook/event notification",
        "status": "REGISTER_DIAL_HTTPS_WEBHOOK",
        "note": "EcoCash developer terms require HMAC validation and idempotent duplicate handling."
      }
    ],
    "dial_endpoints": [
      {
        "method": "POST",
        "path": "/api/v1/payments/intents",
        "purpose": "Create PaymentIntent."
      },
      {
        "method": "POST",
        "path": "/api/v1/payments/{paymentIntentRef}/ecocash/push",
        "purpose": "Initiate direct EcoCash USSD push after validating MSISDN, amount/currency and intent state."
      },
      {
        "method": "GET",
        "path": "/api/v1/payments/{paymentIntentRef}",
        "purpose": "Canonical customer/server status."
      },
      {
        "method": "POST",
        "path": "/api/v1/payments/{paymentIntentRef}/refresh",
        "purpose": "Server-side provider status refresh/query."
      },
      {
        "method": "POST",
        "path": "/api/v1/webhooks/ecocash",
        "purpose": "Receive, HMAC-verify, dedupe and normalize EcoCash events."
      },
      {
        "method": "POST",
        "path": "/api/v1/refunds",
        "purpose": "Create DIAL refund request; adapter executes provider-supported refund only if available/authorized."
      }
    ],
    "provider_states": [
      "PUSH_SENT",
      "CUSTOMER_CONFIRMATION_PENDING",
      "CONFIRMED",
      "DECLINED",
      "EXPIRED",
      "FAILED",
      "REVERSED",
      "REFUNDED"
    ],
    "dial_state_mapping": {
      "PUSH_SENT": "ACTION_REQUIRED",
      "CUSTOMER_CONFIRMATION_PENDING": "ACTION_REQUIRED",
      "CONFIRMED": "CONFIRMED",
      "DECLINED": "FAILED",
      "EXPIRED": "EXPIRED",
      "FAILED": "FAILED",
      "REVERSED": "REVERSED",
      "REFUNDED": "REFUNDED"
    },
    "posting_rule": "Provider confirmation creates/updates the EcoCash clearing asset/payment event; later merchant settlement moves clearing to bank/treasury and books fees separately.",
    "eventualities": [
      "customer does not receive USSD push",
      "wrong phone number",
      "customer declines",
      "USSD expires",
      "webhook delayed/duplicate/out of order",
      "provider status unknown",
      "confirmed payment notification lost",
      "provider reversal",
      "settlement fee mismatch",
      "settlement missing",
      "duplicate customer retry"
    ]
  },
  {
    "channel_id": "PAYNOW",
    "display_name": "Paynow",
    "kind": "PAYMENT_GATEWAY",
    "currencies": "Paynow merchant profile/configuration",
    "confirmation_authority": "validated Paynow result + recommended server poll of Paynow status for consequential update",
    "settlement_authority": "Paynow settlement reconciliation",
    "customer_action": "Redirect/open secure Paynow browser URL generated by server-side initiation.",
    "provider_external_endpoints": [
      {
        "method": "POST",
        "url": "https://www.paynow.co.zw/interface/initiatetransaction",
        "purpose": "Official initiate transaction endpoint."
      },
      {
        "method": "POST",
        "url": "DIAL resulturl",
        "purpose": "Paynow status update callback configured per PaymentIntent."
      },
      {
        "method": "GET",
        "url": "provider-returned pollurl",
        "purpose": "Poll authoritative current status."
      },
      {
        "method": "GET",
        "url": "DIAL returnurl",
        "purpose": "Customer browser return; never payment authority."
      }
    ],
    "dial_endpoints": [
      {
        "method": "POST",
        "path": "/api/v1/payments/intents",
        "purpose": "Create PaymentIntent."
      },
      {
        "method": "POST",
        "path": "/api/v1/payments/{paymentIntentRef}/paynow/initiate",
        "purpose": "Server-side initiate; validate returned hash before exposing browserurl."
      },
      {
        "method": "GET",
        "path": "/api/v1/payments/{paymentIntentRef}/paynow/return",
        "purpose": "Browser return route; render canonical status/refresh."
      },
      {
        "method": "POST",
        "path": "/api/v1/webhooks/paynow/result",
        "purpose": "resulturl handler; validate hash, dedupe and correlate."
      },
      {
        "method": "POST",
        "path": "/api/v1/payments/{paymentIntentRef}/refresh",
        "purpose": "Poll provider-returned pollurl and normalize status."
      },
      {
        "method": "POST",
        "path": "/api/v1/refunds",
        "purpose": "DIAL refund workflow mapped to supported Paynow mechanism/operations policy."
      }
    ],
    "provider_states": [
      "Created",
      "Sent",
      "Paid",
      "Awaiting Delivery",
      "Delivered",
      "Cancelled",
      "Disputed",
      "Refunded"
    ],
    "dial_state_mapping": {
      "Created": "PENDING_PROVIDER",
      "Sent": "ACTION_REQUIRED",
      "Paid": "CONFIRMED",
      "Awaiting Delivery": "CONFIRMED_SUSPENSE",
      "Delivered": "CONFIRMED_SUSPENSE",
      "Cancelled": "CANCELLED",
      "Disputed": "DISPUTED",
      "Refunded": "REFUNDED"
    },
    "posting_rule": "Paynow confirmation posts to the Paynow clearing account. Settlement and fees are reconciled separately. Paynow 'Awaiting Delivery/Delivered' are retained as provider substate and must not be collapsed into DIAL delivery truth.",
    "eventualities": [
      "initiation timeout",
      "invalid response hash",
      "customer abandons browser",
      "result callback duplicated",
      "result callback says paid but poll differs",
      "Created/Sent stale",
      "Awaiting Delivery suspense",
      "Disputed",
      "Refunded",
      "settlement mismatch",
      "payment channel metadata unavailable"
    ]
  },
