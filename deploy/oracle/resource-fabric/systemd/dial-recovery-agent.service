[Unit]
Description=DIAL reciprocal peer recovery agent (architecture sections 13, 14, 20)
After=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
Slice=dial-recovery.slice
Environment=DIAL_FABRIC_STATE=%h/.local/state/dial-fabric
Environment=DIAL_REPO_DIR=%h/dial-new
EnvironmentFile=-/etc/dial-recovery/fabric.env
Environment=PATH=%h/.local/bin:%h/.npm-global/bin:/usr/local/bin:/usr/bin:/bin
UnsetEnvironment=OPENAI_API_KEY CODEX_API_KEY ANTHROPIC_API_KEY
ExecStart=/usr/bin/env node ${DIAL_REPO_DIR}/deploy/oracle/resource-fabric/recovery-agent.mjs daemon
Restart=always
RestartSec=5s
TimeoutStartSec=60
TimeoutStopSec=30
KillSignal=SIGTERM
OOMScoreAdjust=-900
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.local/state/dial-fabric -/var/lib/dial-recovery/fabric

[Install]
WantedBy=default.target
