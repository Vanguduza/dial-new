[Unit]
Description=Desktop Commander (owner host-administration plane, E2 recovery peers only)
Documentation=https://github.com/wonderwhy-er/DesktopCommanderMCP
After=network-online.target

[Service]
Type=simple
Slice=dial-recovery.slice
# Owner admin tooling. This is NOT the DIAL operator gateway and must never be
# used to dispatch DIAL development work — see CLAUDE.md: the DIAL operator
# channel exposes no generic shell.
ExecStart=/usr/bin/env npx -y @wonderwhy-er/desktop-commander@latest
Restart=always
RestartSec=5s
StartLimitIntervalSec=0
TimeoutStartSec=60
TimeoutStopSec=30
KillSignal=SIGTERM
OOMScoreAdjust=-700
NoNewPrivileges=true

[Install]
WantedBy=default.target
