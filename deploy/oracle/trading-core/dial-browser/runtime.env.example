DIAL_BROWSER_BIND=127.0.0.1
DIAL_BROWSER_PORT=9150
DIAL_BROWSER_AUTH_MODE=SSH_TUNNEL_ONLY
DIAL_BROWSER_TOKEN_FILE=/var/lib/dial-browser/secrets/api.token
DIAL_BROWSER_EVIDENCE_ROOT=/var/lib/dial-browser/evidence
DIAL_BROWSER_PROFILE_ROOT=/var/lib/dial-browser/profiles
DIAL_BROWSER_MAX_BODY_BYTES=65536
DIAL_BROWSER_MAX_RESULT_BYTES=180000
DIAL_BROWSER_NAV_TIMEOUT_MS=20000
DIAL_BROWSER_MAX_LINKS=12
PLAYWRIGHT_BROWSERS_PATH=/opt/dial-browser-runtime/browsers
DIAL_STAGEHAND_ENABLED=1
DIAL_STAGEHAND_MODEL=groq/openai/gpt-oss-20b
DIAL_STAGEHAND_API_KEY_FILE=/var/lib/dial-browser/secrets/stagehand-model.key
DIAL_STAGEHAND_MODEL_PROXY=http://127.0.0.1:9152
DIAL_STAGEHAND_CHROME_PATH=/opt/dial-browser-runtime/browsers/chromium-1243/chrome-linux-arm64/chrome
