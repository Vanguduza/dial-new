FROM ubuntu:24.04@sha256:224a1869083a311ef3f13648a154ba79832fbef6364d31493642ca03082da254
ENV DEBIAN_FRONTEND=noninteractive
ARG NODE_VERSION=22.23.3
ARG NODE_ARM64_SHA256=a44aeb94849a299b22df10b9e622ec2f605c2183501bc40590705131de7c740f
ARG NODE_X64_SHA256=df450af89261115ef9f9e3830c3eeb2cc9213b63c720b1af623cb5dcbe2e02de
RUN apt-get update \
  && apt-get install -y --no-install-recommends \
    ca-certificates=20260601~24.04.1 \
    curl=8.5.0-2ubuntu10.13 \
    git=1:2.43.0-1ubuntu7.3 \
    python3=3.12.3-0ubuntu2.1 \
    python3-pip=24.0+dfsg-1ubuntu1.3 \
    build-essential=12.10ubuntu1 \
    tini=0.19.0-1 \
    xz-utils=5.6.1+really5.4.5-1ubuntu0.3 \
  && arch="$(dpkg --print-architecture)" \
  && case "$arch" in \
       arm64) node_arch=arm64; node_sha="$NODE_ARM64_SHA256" ;; \
       amd64) node_arch=x64; node_sha="$NODE_X64_SHA256" ;; \
       *) echo "unsupported architecture: $arch" >&2; exit 3 ;; \
     esac \
  && curl --proto '=https' --tlsv1.2 -fsSLo /tmp/node.tar.xz "https://nodejs.org/dist/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-${node_arch}.tar.xz" \
  && echo "$node_sha  /tmp/node.tar.xz" | sha256sum -c - \
  && mkdir -p /opt/node \
  && tar -xJf /tmp/node.tar.xz --strip-components=1 -C /opt/node \
  && ln -sf /opt/node/bin/node /usr/local/bin/node \
  && ln -sf /opt/node/bin/npm /usr/local/bin/npm \
  && ln -sf /opt/node/bin/npx /usr/local/bin/npx \
  && rm -f /tmp/node.tar.xz \
  && rm -rf /var/lib/apt/lists/*
WORKDIR /workspace
USER nobody
ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["sleep", "infinity"]
