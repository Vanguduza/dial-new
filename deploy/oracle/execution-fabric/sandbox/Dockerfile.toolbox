FROM ubuntu:24.04
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update \
  && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    git \
    python3 \
    python3-pip \
    nodejs \
    npm \
    build-essential \
    tini \
  && rm -rf /var/lib/apt/lists/*
WORKDIR /workspace
USER nobody
ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["sleep", "infinity"]
