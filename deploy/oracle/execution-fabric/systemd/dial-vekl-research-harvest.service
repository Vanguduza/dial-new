[Unit]
Description=DIAL VEKL public research harvest worker
After=network-online.target
Wants=network-online.target
ConditionPathExists=/etc/dial/research-harvest.env

[Service]
Type=oneshot
User=dial-worker
Group=dial-worker
EnvironmentFile=/etc/dial/research-harvest.env
ExecStart=/usr/bin/node /opt/dial/deploy/oracle/execution-fabric/dial-vekl-research-harvest-worker.mjs run
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/dial-worker/research-harvest
UMask=0077
