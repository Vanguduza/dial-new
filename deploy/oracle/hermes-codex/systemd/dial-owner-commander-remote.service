[Unit]
Description=DIAL owner-facing Desktop Commander remote transport
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0
ConditionPathExists=%h/.desktop-commander-device/device.json

[Service]
Type=simple
ExecStart=%h/.local/share/dial/desktop-commander/node_modules/.bin/desktop-commander remote
Restart=always
RestartSec=10s
TimeoutStartSec=90s
TimeoutStopSec=30s
KillSignal=SIGTERM
Slice=dial-owner-commander.slice
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.desktop-commander-device
ProtectControlGroups=true
ProtectKernelTunables=true
RestrictSUIDSGID=true
UnsetEnvironment=OPENAI_API_KEY CODEX_API_KEY ANTHROPIC_API_KEY
Environment=NODE_OPTIONS=--max-old-space-size=256
Environment=PATH=%h/.local/bin:%h/.npm-global/bin:/usr/local/bin:/usr/bin:/bin

[Install]
WantedBy=default.target
