#!/usr/bin/env bash
set -Eeuo pipefail
umask 077

ACTION="${1:-}"
SERVICE="${2:-}"
COMMAND_B64="${3:-}"
ACK="${4:-}"
ACTOR="${5:-}"
REF="${6:-}"
EVENT="${7:-}"
RUN_ID="${8:-}"
RUN_SHA="${9:-}"
TARGET="${10:-}"
ORACLE_ACTION="${11:-}"

AUDIT_DIR=/var/log/dial-github-admin
AUDIT=$AUDIT_DIR/audit.jsonl
REPO=/home/ubuntu/dial-new

mkdir -p "$AUDIT_DIR"
chmod 0700 "$AUDIT_DIR"
touch "$AUDIT"
chmod 0600 "$AUDIT"

refuse(){ echo "REFUSE: $*" >&2; exit 3; }
[[ "$ACTOR" == "Vanguduza" ]] || refuse "only repository owner may use Netcup admin runner"
[[ "$REF" == "master" ]] || refuse "admin runner accepts master only; got $REF"
[[ "$EVENT" == "workflow_dispatch" ]] || refuse "workflow_dispatch required"
[[ "$RUN_ID" =~ ^[0-9]+$ ]] || refuse "GitHub run id missing"
[[ "$RUN_SHA" =~ ^[0-9a-f]{40}$ ]] || refuse "GitHub run SHA invalid"

audit(){
  local result="$1" hash="${2:-}"
  printf '{"at":"%s","actor":"%s","run_id":"%s","run_sha":"%s","action":"%s","service":"%s","command_sha256":"%s","result":"%s"}\n'     "$(date -u +%FT%TZ)" "$ACTOR" "$RUN_ID" "$RUN_SHA" "$ACTION" "$SERVICE" "$hash" "$result" >>"$AUDIT"
}

status(){
  hostname
  date -u
  uptime
  free -h
  df -h /
  systemctl is-active ssh || true
  runuser -u ubuntu -- systemctl --user is-active dial-hermes-runtime.service 2>/dev/null || true
  runuser -u ubuntu -- systemctl --user is-active dial-owner-commander-remote.service 2>/dev/null || true
  test -d "$REPO/.git" && git -C "$REPO" rev-parse HEAD || true
}

case "$ACTION" in
  status)
    audit START
    status
    audit PASS
    ;;
  verify)
    audit START
    [[ -x "$REPO/ops/development-bootstrap/bootstrap.sh" ]] || refuse "DIAL bootstrap missing"
    runuser -u ubuntu -- env HOME=/home/ubuntu DIAL_REPO_DIR="$REPO"       "$REPO/ops/development-bootstrap/bootstrap.sh" --verify --role dial-hermes-control --profile CORE_DEVELOPMENT
    audit PASS
    ;;
  restart-service)
    case "$SERVICE" in
      dial-hermes-runtime.service|dial-hermes-orchestrator.service|dial-chat-control.service|dial-owner-steering.service|dial-remote-mcp-relay.service|dial-private-mcp-bind.service|dial-owner-commander-remote.service|hermes-dial-dashboard.service) ;;
      *) refuse "service not on GitHub admin restart allowlist" ;;
    esac
    audit START
    runuser -u ubuntu -- env HOME=/home/ubuntu XDG_RUNTIME_DIR=/run/user/$(id -u ubuntu)       systemctl --user restart "$SERVICE"
    runuser -u ubuntu -- env HOME=/home/ubuntu XDG_RUNTIME_DIR=/run/user/$(id -u ubuntu)       systemctl --user is-active "$SERVICE"
    audit PASS
    ;;
  oracle-status)
    audit START
    command -v oci >/dev/null || refuse "OCI CLI absent"
    [[ -s /home/ubuntu/.oci/config ]] || refuse "OCI config absent"
    [[ -s /etc/dial/oracle-estate.env ]] || refuse "Oracle estate inventory absent"
    # shellcheck disable=SC1091
    . /etc/dial/oracle-estate.env
    [[ -n "${DIAL_OCI_COMPARTMENT:-}" ]] || refuse "DIAL_OCI_COMPARTMENT missing"
    sudo -u ubuntu -H oci compute instance list --compartment-id "$DIAL_OCI_COMPARTMENT"       --query 'data[].{"name":"display-name","state":"lifecycle-state","id":id}' --output table
    audit PASS
    ;;
  oracle-action)
    [[ "$ACK" == "I_UNDERSTAND_ORACLE_RECOVERY" ]] || refuse "Oracle lifecycle action requires exact acknowledgement"
    [[ -s /etc/dial/oracle-estate.env ]] || refuse "Oracle estate inventory absent"
    # shellcheck disable=SC1091
    . /etc/dial/oracle-estate.env
    case "$TARGET" in
      van-trading-core) instance_id="${VAN_TRADING_CORE_OCID:-}" ;;
      vekl-worker) instance_id="${VEKL_WORKER_OCID:-}" ;;
      oracle-admin) instance_id="${ORACLE_ADMIN_OCID:-}" ;;
      *) refuse "unknown Oracle target" ;;
    esac
    [[ -n "$instance_id" ]] || refuse "OCID missing for $TARGET"
    case "$ORACLE_ACTION" in
      START|STOP|SOFTRESET) ;;
      *) refuse "allowed Oracle actions: START STOP SOFTRESET" ;;
    esac
    audit START
    sudo -u ubuntu -H oci compute instance action --instance-id "$instance_id" --action "$ORACLE_ACTION"
    audit PASS
    ;;
  raw-b64)
    [[ "$ACK" == "I_UNDERSTAND_ROOT" ]] || refuse "raw root command requires exact acknowledgement"
    [[ -n "$COMMAND_B64" ]] || refuse "empty command"
    cmd="$(printf '%s' "$COMMAND_B64" | base64 -d 2>/dev/null)" || refuse "invalid base64 command"
    [[ -n "$cmd" ]] || refuse "decoded command empty"
    hash="$(printf '%s' "$cmd" | sha256sum | awk '{print $1}')"
    audit START "$hash"
    printf '%s\n' "$cmd" | /bin/bash -seuo pipefail
    audit PASS "$hash"
    ;;
  *)
    refuse "unsupported action"
    ;;
esac
