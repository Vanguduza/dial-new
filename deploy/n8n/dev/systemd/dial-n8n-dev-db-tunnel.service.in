[Unit]
Description=DIAL n8n DEV PostgreSQL tunnel to vekl-worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/ssh -NT -o BatchMode=yes -o ExitOnForwardFailure=yes -o ServerAliveInterval=30 -o ServerAliveCountMax=3 -L 127.0.0.1:@TUNNEL_PORT@:127.0.0.1:5432 @WORKER_TARGET@
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
