# Non-secret deployment settings. bootstrap.sh creates the three secret values
# in a separate 0600 runtime.env and never prints them.
VEKL_WORKER_SSH_TARGET=vekl-worker
N8N_DEV_DB_TUNNEL_PORT=55432
N8N_DEV_HTTP_PORT=5678
N8N_DEV_HOST=127.0.0.1
N8N_DEV_PROTOCOL=http
N8N_DEV_WEBHOOK_URL=http://127.0.0.1:5678/
N8N_DEV_EDITOR_BASE_URL=http://127.0.0.1:5678/
DIAL_TIMEZONE=Africa/Harare

# Generated, never commit values:
N8N_DEV_DB_PASSWORD=
N8N_DEV_ENCRYPTION_KEY=
N8N_DEV_RUNNERS_AUTH_TOKEN=
