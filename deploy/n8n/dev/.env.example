# DIAL_N8N_DEV variable names. No values are committed to this repository.
#
# Every value here is development-only. A production credential in this estate
# fails `assertEstateIsolation` (DEV_HOLDS_PRODUCTION_CREDENTIALS) and is a
# security incident rather than a convenience.
#
# Copy to `.env` beside the compose file at deploy time and fill in from the
# operator's own credential store. `.env` itself is never committed.
N8N_DEV_DB_NAME=n8n_dev
N8N_DEV_DB_USER=
N8N_DEV_DB_PASSWORD=
N8N_DEV_ENCRYPTION_KEY=
N8N_DEV_HOST=hooks-dev.dial.internal
N8N_DEV_WEBHOOK_URL=https://hooks-dev.dial.internal/
N8N_DEV_ADMIN_USER=
N8N_DEV_ADMIN_PASSWORD=
DIAL_TIMEZONE=Africa/Harare
