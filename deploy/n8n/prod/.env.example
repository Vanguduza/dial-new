# DIAL_N8N_PROD variable names. No values are committed to this repository.
#
# These identifiers must differ from every DIAL_N8N_DEV identifier: database,
# encryption key, credential store, webhook host and admin account are separate
# objects, not the same object under two names. Sharing any of them fails
# `assertEstateIsolation`.
#
# Copy to `.env` beside the compose file at deploy time and fill in from the
# operator's own credential store. `.env` itself is never committed.
N8N_PROD_DB_NAME=n8n_prod
N8N_PROD_DB_USER=
N8N_PROD_DB_PASSWORD=
N8N_PROD_ENCRYPTION_KEY=
N8N_PROD_HOST=hooks.dial.internal
N8N_PROD_WEBHOOK_URL=https://hooks.dial.internal/
N8N_PROD_ADMIN_USER=
N8N_PROD_ADMIN_PASSWORD=
DIAL_TIMEZONE=Africa/Harare
