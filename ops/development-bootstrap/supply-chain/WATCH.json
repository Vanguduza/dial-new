{
  "schema_version": 1,
  "authority_note": "Declares how each PINS.json entry is watched upstream. The watcher proposes the newest release within the pinned major with verified checksum/integrity material, updates every consumer copy of the pin, and records release notes and advisories as VEKL RELEASE_NOTES / SECURITY_ADVISORY references (reference-only, never authority). Changes take effect only through an owner-approved PR (auth-20260924-delegated-supply-chain-pin-refresh). Newer majors and entries with auto=false are proposals in WATCH_REPORT.json, never applied.",
  "policy": {
    "select": "LATEST_STABLE_WITHIN_PINNED_MAJOR",
    "prereleases": false,
    "newer_major": "PROPOSE_ONLY"
  },
  "pins": {
    "node": {
      "auto": true,
      "source": { "kind": "node_dist", "arches": { "x64": "linux-x64", "arm64": "linux-arm64" } },
      "release_notes": "https://nodejs.org/en/blog/release/v{version}",
      "consumers": [
        "deploy/oracle/hermes-codex/install-pinned-node.sh",
        "deploy/netcup/hermes-control/image-bootstrap.sh",
        "deploy/netcup/hermes-control/rescue-prestage-control-plane.sh",
        "deploy/netcup/hermes-control/install-github-oidc-control.sh",
        "deploy/oracle/provisioning/bootstrap.sh",
        "deploy/oracle/execution-fabric/sandbox/Dockerfile.toolbox",
        "ops/development-bootstrap/DEVELOPMENT_CAPABILITY_REGISTRY.json"
      ]
    },
    "@openai/codex": {
      "auto": true,
      "source": { "kind": "npm", "package": "@openai/codex" },
      "repository": "openai/codex",
      "consumers": ["ops/development-bootstrap/DEVELOPMENT_CAPABILITY_REGISTRY.json"]
    },
    "claude-code": {
      "auto": true,
      "source": { "kind": "claude_installer", "version_package": "@anthropic-ai/claude-code" },
      "repository": "anthropics/claude-code",
      "consumers": ["ops/development-bootstrap/DEVELOPMENT_CAPABILITY_REGISTRY.json"]
    },
    "hermes-agent": {
      "auto": true,
      "source": { "kind": "github_source_archive", "repository": "NousResearch/hermes-agent" },
      "consumers": []
    },
    "antigravity-cli": {
      "auto": true,
      "source": {
        "kind": "github_release_assets",
        "repository": "google-antigravity/antigravity-cli",
        "assets": { "x64": "agy_cli_linux_x64.tar.gz", "arm64": "agy_cli_linux_arm64.tar.gz" }
      },
      "consumers": [
        "deploy/oracle/hermes-codex/install-google-antigravity.sh",
        "ops/development-bootstrap/providers/google.mjs",
        "ops/development-bootstrap/manifest.json",
        "ops/development-bootstrap/DEVELOPMENT_CAPABILITY_REGISTRY.json"
      ]
    },
    "context7-mcp": {
      "auto": true,
      "source": { "kind": "npm", "package": "@upstash/context7-mcp" },
      "repository": "upstash/context7",
      "npm_lock_dir": "deploy/oracle/hermes-codex/research-mcp-runtime",
      "consumers": [
        "deploy/oracle/hermes-codex/install-research-mcp.sh",
        "deploy/oracle/hermes-codex/research-mcp-runtime/package.json",
        "ops/development-bootstrap/manifest.json",
        "ops/development-bootstrap/DEVELOPMENT_CAPABILITY_REGISTRY.json"
      ]
    },
    "github_actions_runner": {
      "auto": true,
      "source": {
        "kind": "github_release_asset",
        "repository": "actions/runner",
        "asset": "actions-runner-linux-x64-{version}.tar.gz"
      },
      "consumers": ["deploy/netcup/hermes-control/install-github-admin-runner.sh"]
    },
    "uv": {
      "auto": true,
      "source": { "kind": "github_release_version", "repository": "astral-sh/uv" },
      "consumers": ["deploy/netcup/hermes-control/install-artemis-android-testing-plane.sh"]
    },
    "openviking": {
      "auto": true,
      "source": { "kind": "ghcr_image", "image": "volcengine/openviking", "repository": "volcengine/OpenViking" },
      "consumers": []
    },
    "@wonderwhy-er/desktop-commander": {
      "auto": false,
      "review_reason": "commander-session-persistence-patch.sh hot-patches dist/remote-device/device.js of this exact version to keep the owner device session; a new version needs the patch re-derived and re-verified before the pin moves.",
      "source": { "kind": "npm", "package": "@wonderwhy-er/desktop-commander" },
      "repository": "wonderwhy-er/DesktopCommanderMCP",
      "consumers": []
    },
    "exa-remote-bridge": { "auto": false, "review_reason": "repository-owned bridge; no upstream release", "source": { "kind": "none" } },
    "apt": { "auto": false, "review_reason": "exact Ubuntu archive versions are recorded from apt-cache policy on the target host", "source": { "kind": "none" } },
    "toolbox_base": { "auto": false, "review_reason": "sandbox base image digest is re-derived with the toolbox build", "source": { "kind": "none" } },
    "whatsapp_pair_runtime": { "auto": false, "review_reason": "vendored tarball plus lockfile; owner-reviewed channel runtime", "source": { "kind": "none" } },
    "artemis": { "auto": false, "review_reason": "frozen git commit plus DIAL hardening patches", "source": { "kind": "none" } }
  }
}
