{
  "schema_version": 1,
  "manifest_id": "dial-development-bootstrap-v1",
  "authority": "DECLARATIVE_DESIRED_STATE_FOR_DEVELOPMENT_HOSTS",
  "authority_note": "This manifest declares required state; it grants no authority. Canonical installers under deploy/oracle/hermes-codex remain the mechanism for the Hermes control plane; the bootstrap detects, verifies, wraps and never duplicates them. Secrets never appear here (credentials carry references only).",
  "canonical_repository": "Vanguduza/dial-new",
  "canonical_branch": "master",
  "control_plane_fingerprint_paths": ["agent-system/orchestration", "agent-system/engineering-knowledge", "deploy/oracle/hermes-codex"],
  "roles": {
    "dial-hermes-control": { "definition": "roles/roles.json#roles.dial-hermes-control" },
    "vekl-worker": { "definition": "roles/roles.json#roles.vekl-worker" },
    "oracle-admin": { "definition": "roles/roles.json#roles.oracle-admin" },
    "provider-container": { "definition": "roles/roles.json#roles.provider-container" }
  },
  "packages": [
    { "id": "pkg.git", "binary": "git", "minimum_version": "2.39.0", "install_method": "APT_PINNED", "hosts": ["dial-hermes-control", "vekl-worker", "oracle-admin", "provider-container"], "criticality": "MANDATORY", "remediation": "apt-get install git" },
    { "id": "pkg.jq", "binary": "jq", "minimum_version": "1.6.0", "install_method": "APT_PINNED", "hosts": ["dial-hermes-control", "vekl-worker", "oracle-admin"], "criticality": "REQUIRED", "remediation": "apt-get install jq" },
    { "id": "pkg.ripgrep", "binary": "rg", "minimum_version": "13.0.0", "install_method": "APT_PINNED", "hosts": ["dial-hermes-control", "vekl-worker"], "criticality": "REQUIRED", "remediation": "apt-get install ripgrep" },
    { "id": "pkg.sqlite3", "binary": "sqlite3", "minimum_version": "3.37.0", "install_method": "APT_PINNED", "hosts": ["dial-hermes-control"], "criticality": "MANDATORY", "remediation": "apt-get install sqlite3 (required for transaction-consistent Hermes state.db backup)" },
    { "id": "pkg.openssh", "binary": "ssh", "minimum_version": "8.0.0", "version_args": ["-V"], "install_method": "APT_PINNED", "hosts": ["dial-hermes-control", "vekl-worker", "oracle-admin"], "criticality": "MANDATORY", "remediation": "apt-get install openssh-client" }
  ],
  "runtimes": [
    { "id": "rt.node", "binary": "node", "minimum_version": "22.13.0", "install_method": "VENDOR_INSTALLER_UNPINNED", "hosts": ["dial-hermes-control", "vekl-worker", "provider-container"], "criticality": "MANDATORY", "supply_chain_note": "bootstrap-host.sh uses curl|sudo bash NodeSource setup (unpinned). Prefer distro/NodeSource apt repo with pinned major and signed key.", "remediation": "install Node 22 LTS via pinned apt source" },
    { "id": "rt.npm", "binary": "npm", "minimum_version": "10.0.0", "install_method": "PREINSTALLED", "hosts": ["dial-hermes-control", "vekl-worker", "provider-container"], "criticality": "MANDATORY" },
    { "id": "rt.python3", "binary": "python3", "minimum_version": "3.10.0", "install_method": "APT_PINNED", "hosts": ["dial-hermes-control", "vekl-worker", "provider-container"], "criticality": "MANDATORY", "remediation": "apt-get install python3 python3-yaml (project-truth guard and installers)" },
    { "id": "rt.codex", "binary": "codex", "minimum_version": "0.144.0", "install_method": "NPM_EXACT", "hosts": ["dial-hermes-control"], "criticality": "MANDATORY", "package": "@openai/codex", "supply_chain_note": "bootstrap-host.sh installs @openai/codex@latest (floating). Pin the exact qualified version in this manifest field `pinned_version` once qualified on the host.", "pinned_version": null, "remediation": "npm install -g @openai/codex@<pinned>" },
    { "id": "rt.claude-code", "binary": "claude", "minimum_version": "2.0.0", "install_method": "VENDOR_INSTALLER_UNPINNED", "hosts": ["dial-hermes-control", "provider-container"], "criticality": "MANDATORY", "supply_chain_note": "bootstrap-host.sh uses curl https://claude.ai/install.sh | bash (unpinned). Record the installed version as evidence; pin once a versioned installer path is adopted.", "remediation": "install official Claude Code CLI" },
    { "id": "rt.hermes", "binary": "hermes", "minimum_version": null, "install_method": "VENDOR_INSTALLER_UNPINNED", "hosts": ["dial-hermes-control"], "criticality": "MANDATORY", "supply_chain_note": "bootstrap-host.sh uses curl https://hermes-agent.nousresearch.com/install.sh | bash (unpinned third-party domain).", "remediation": "install Hermes agent per bootstrap-host.sh then hermes auth add openai-codex" },
    { "id": "rt.antigravity", "binary": "agy", "exact_version": "1.2.0", "install_method": "RELEASE_TARBALL_SHA256", "hosts": ["dial-hermes-control"], "criticality": "OPTIONAL", "remediation": "bash deploy/oracle/hermes-codex/install-google-antigravity.sh" }
  ],
  "services": [
    { "id": "svc.dial-hermes-runtime", "unit": "dial-hermes-runtime.service", "scope": "user", "hosts": ["dial-hermes-control"], "criticality": "MANDATORY", "installer": "deploy/oracle/hermes-codex/install-control-plane.sh", "workload": "HERMES_RUNTIME" },
    { "id": "svc.dial-hermes-orchestrator", "unit": "dial-hermes-orchestrator.service", "scope": "user", "hosts": ["dial-hermes-control"], "criticality": "MANDATORY", "installer": "deploy/oracle/hermes-codex/install-external-orchestrator.sh", "workload": "EXTERNAL_QUEUE" },
    { "id": "svc.dial-hermes-operations", "unit": "dial-hermes-operations.service", "scope": "user", "hosts": ["dial-hermes-control"], "criticality": "REQUIRED", "installer": "deploy/oracle/hermes-codex/install-operations-plane.sh", "workload": "DIAGNOSTICS" },
    { "id": "svc.dial-chat-control", "unit": "dial-chat-control.service", "scope": "user", "hosts": ["dial-hermes-control"], "criticality": "MANDATORY", "installer": "deploy/oracle/hermes-codex/install-chat-control-bridge.sh", "workload": "OPERATOR_GATEWAY", "port": 9130 },
    { "id": "svc.dial-mission-controller", "unit": "dial-mission-controller.service", "scope": "user", "hosts": ["dial-hermes-control"], "criticality": "MANDATORY", "installer": "deploy/oracle/hermes-codex/install-chat-control-bridge.sh", "workload": "MISSION_CONTROL" },
    { "id": "svc.dial-owner-steering", "unit": "dial-owner-steering.service", "scope": "user", "hosts": ["dial-hermes-control"], "criticality": "MANDATORY", "installer": "deploy/oracle/hermes-codex/install-operator-gateway.sh", "workload": "OWNER_CONTROL" },
    { "id": "svc.dial-hermes-whatsapp-operator", "unit": "dial-hermes-whatsapp-operator.service", "scope": "user", "hosts": ["dial-hermes-control"], "criticality": "OPTIONAL", "installer": "deploy/oracle/hermes-codex/install-operator-gateway.sh", "workload": "OWNER_CONTROL" },
    { "id": "svc.dial-whatsapp-cloud-operator", "unit": "dial-whatsapp-cloud-operator.service", "scope": "user", "hosts": ["dial-hermes-control"], "criticality": "OPTIONAL", "installer": "deploy/oracle/hermes-codex/install-operator-gateway.sh", "workload": "OWNER_CONTROL", "port": 9132 },
    { "id": "svc.dial-operator-status-publisher", "unit": "dial-operator-status-publisher.timer", "scope": "user", "hosts": ["dial-hermes-control"], "criticality": "REQUIRED", "installer": "deploy/oracle/hermes-codex/install-operator-status-publisher.sh", "workload": "DIAGNOSTICS" },
    { "id": "svc.dial-engineering-research", "unit": "dial-engineering-research.timer", "scope": "user", "hosts": ["dial-hermes-control"], "criticality": "REQUIRED", "installer": "deploy/oracle/hermes-codex/install-engineering-research.sh", "workload": "VEKL_RESEARCH" },
    { "id": "svc.hermes-dial-dashboard", "unit": "hermes-dial-dashboard.service", "scope": "user", "hosts": ["dial-hermes-control"], "criticality": "OPTIONAL", "installer": "deploy/oracle/hermes-codex/install-control-plane.sh", "workload": "DIAGNOSTICS", "port": 9119 },
    { "id": "svc.dial-hermes-haif", "unit": "dial-hermes-haif.service", "scope": "user", "hosts": ["dial-hermes-control"], "criticality": "OPTIONAL", "installer": "deploy/oracle/hermes-codex/install-haif.sh", "workload": "DIAGNOSTICS", "port": 9141 },
    { "id": "svc.dial-worker-agent", "unit": "dial-worker-agent.timer", "scope": "user", "hosts": ["vekl-worker"], "criticality": "REQUIRED", "installer": "ops/development-bootstrap/workers/install-worker-agent.sh", "workload": "WORKER_JOB", "status_note": "NEW in this bootstrap: publishes a signed-by-hash capability envelope and executes allowlisted jobs; not yet live on any host." }
  ],
  "containers": [],
  "containers_note": "Canonical DIAL deployment uses systemd user units with sandboxing (NoNewPrivileges, ProtectSystem=strict, ReadOnlyPaths). No Docker/Compose/Podman exists in the repository; container checks are NOT_APPLICABLE unless a role declares a container workload.",
  "mcp_servers": [
    { "id": "mcp.dial-oracle-status", "name": "dial-oracle-status", "transport": "stdio", "command": "node agent-system/orchestration/claude-oracle-status-mcp.mjs", "purpose": "Read-only Oracle mission/queue/gate/runtime mirror (false-idle prevention)", "clients": ["claude"], "config_location": ".mcp.json", "hosts": ["dial-hermes-control", "provider-container"], "auth_type": "NONE", "health_probe": "dial_oracle_status tool returns available=true", "criticality": "REQUIRED", "owner": "DIAL control plane", "security_classification": "PUBLIC_STATUS" },
    { "id": "mcp.dial-oracle-control", "name": "dial-oracle-control", "transport": "stdio", "command": "node agent-system/orchestration/operator-control-stdio.mjs", "purpose": "Mutable typed owner controls (dial_owner_steer, dial_owner_live_turn, dial_submit_instruction, status/gate tools) for local Claude and Codex", "clients": ["claude", "codex"], "config_location": "client-local scope via install-operator-gateway.sh", "hosts": ["dial-hermes-control"], "auth_type": "NONE", "auth_note": "process-env channel identity; bridge bearer token stays server-side", "health_probe": "qualify-control-plane.sh enrollment assertions", "criticality": "MANDATORY", "owner": "DIAL control plane", "security_classification": "OWNER_CONTROL" },
    { "id": "mcp.dial-chat-control-http", "name": "dial.mcp.oracle-control", "transport": "http", "endpoint": "http://127.0.0.1:9130", "purpose": "Shared typed control authority behind the operator MCPs (21 dial_* tools)", "clients": ["operator-control-stdio", "whatsapp adapters"], "config_location": "systemd unit dial-chat-control.service", "hosts": ["dial-hermes-control"], "auth_type": "NON_INTERACTIVE_SECRET", "secret_refs": ["/var/lib/dial-control/secrets/chat-control.token"], "health_probe": "GET /health -> dial-chat-control", "criticality": "MANDATORY", "owner": "DIAL control plane", "security_classification": "OWNER_CONTROL" },
    { "id": "mcp.dial-truth", "name": "dial-truth", "transport": "stdio", "command": null, "purpose": "Read-only canon: get_feature/get_decision/get_module/get_donor/get_evidence/search_canon", "clients": ["claude", "codex"], "config_location": "agent-system/mcp/dial-truth-server.README.md (contract only)", "hosts": ["dial-hermes-control", "provider-container"], "auth_type": "NONE", "health_probe": null, "criticality": "OPTIONAL", "owner": "DIAL", "security_classification": "PUBLIC_CANON", "status_note": "DOCUMENTED_NOT_IMPLEMENTED: no server module exists; do not enable." },
    { "id": "mcp.github", "name": "github", "transport": "http", "purpose": "Repository/PR/CI operations from provider containers", "clients": ["claude-code-remote"], "config_location": "provider-managed (Claude Code Remote harness)", "hosts": ["provider-container"], "auth_type": "OAUTH_BROWSER", "health_probe": "get_me returns the owner login", "criticality": "REQUIRED", "owner": "provider", "security_classification": "REPOSITORY_WRITE" },
    { "id": "mcp.desktop-commander", "name": "desktop-commander", "transport": "stdio-over-ssh", "purpose": "Owner host-administration surface on the recovery plane; never a development dispatch path", "clients": ["owner desktop client"], "config_location": "unmerged lineage deploy/oracle/resource-fabric (PR #24/#27)", "hosts": ["oracle-admin"], "auth_type": "DEVICE_CODE", "pinned_version": "0.2.50", "health_probe": "PROCESS_UP/SESSION_VALID/REMOTE_REGISTERED/PING_RESPONDS/COMMAND_EXECUTES", "criticality": "OPTIONAL", "owner": "owner", "security_classification": "BREAK_GLASS", "status_note": "Absent from canonical master; exists only on unmerged PR lineage." }
  ],
  "providers": [
    { "id": "prov.claude", "name": "Claude Code (official CLI, subscription)", "role": "HERMES_FALLBACK_RUNTIME + worker harness + provider-container development", "binary": "claude", "models_exact": ["claude-sonnet-5"], "models_worker_candidates": ["claude-opus-5", "claude-fable-5-1", "claude-haiku-4-5-20251001"], "auth_type": "PROVIDER_LOGIN", "auth_probe": "claude auth status", "forbidden_env": ["ANTHROPIC_API_KEY"], "hosts": ["dial-hermes-control", "provider-container"], "criticality": "MANDATORY" },
    { "id": "prov.codex", "name": "OpenAI Codex CLI / App Server (ChatGPT subscription OAuth)", "role": "HERMES_PRIMARY_RUNTIME (exact gpt-5.6-sol)", "binary": "codex", "models_exact": ["gpt-5.6-sol"], "auth_type": "PROVIDER_LOGIN", "auth_probe": "codex login status contains 'Logged in using ChatGPT'", "forbidden_env": ["OPENAI_API_KEY", "CODEX_API_KEY"], "hosts": ["dial-hermes-control"], "criticality": "MANDATORY" },
    { "id": "prov.hermes", "name": "Hermes agent (NousResearch)", "role": "Manager orchestration runtime hosting the locked Sol -> Sonnet chain", "binary": "hermes", "auth_type": "PROVIDER_LOGIN", "auth_probe": "hermes config.yaml provider=openai-codex, default=gpt-5.6-sol, fallback_providers=[]", "hosts": ["dial-hermes-control"], "criticality": "MANDATORY" },
    { "id": "prov.xkiro", "name": "xKiro HAIF (auxiliary, FREE_ONLY, non-authoritative)", "role": "Bounded auxiliary analysis (classify/summarize/compare); never manager, worker or truth", "auth_type": "API_KEY", "secret_refs": ["/var/lib/dial-control/secrets/xkiro-api.key"], "auth_probe": "HAIF tenant daemon GET /health + real usage endpoint canary (never printed)", "hosts": ["dial-hermes-control"], "criticality": "OPTIONAL" },
    { "id": "prov.google-antigravity", "name": "Google Antigravity (worker-only harness)", "auth_type": "OAUTH_BROWSER", "auth_probe": "agy sign-in status + DIAL_ANTIGRAVITY_CANARY_OK", "kill_switch": "DIAL_ANTIGRAVITY_ENABLED", "hosts": ["dial-hermes-control"], "criticality": "OPTIONAL" },
    { "id": "prov.google-stitch", "name": "Google Stitch (design provider, non-authoritative)", "auth_type": "API_KEY", "secret_refs": ["STITCH_API_KEY or STITCH_ACCESS_TOKEN + GOOGLE_CLOUD_PROJECT (secret store, not repo)"], "kill_switch": "DIAL_STITCH_ENABLED", "hosts": ["dial-hermes-control"], "criticality": "OPTIONAL" },
    { "id": "prov.google-pomelli", "name": "Google Pomelli (GMPC creative, human-operated web app)", "auth_type": "HUMAN_APPROVAL", "hosts": [], "criticality": "OPTIONAL", "note": "WEB_APPLICATION; not a development harness; no host placement." }
  ],
  "plugins": [
    { "id": "plg.claude-hooks", "name": "DIAL Claude Code hooks (.claude/settings.json)", "type": "HOOK", "hosts": ["dial-hermes-control", "provider-container"], "criticality": "REQUIRED", "health_probe": "SessionStart hook injects Oracle snapshot; PreToolUse guard denies destructive commands" },
    { "id": "plg.claude-skills", "name": "DIAL skills (.claude/skills, 6) and read-only subagents (.claude/agents, 7)", "type": "SKILL", "hosts": ["dial-hermes-control", "provider-container"], "criticality": "REQUIRED" },
    { "id": "plg.hermes-hooks", "name": "Hermes pre/post turn hooks", "type": "HOOK", "hosts": ["dial-hermes-control"], "criticality": "MANDATORY", "config_location": "~/.hermes/config.yaml hooks" },
    { "id": "plg.dial-development-governor", "name": "dial-development-governor plugin", "type": "PLUGIN", "hosts": [], "criticality": "OPTIONAL", "status_note": "Present in tree, not installed anywhere; hooks duplicated by agent-system/hooks." },
    { "id": "plg.context7", "name": "Context7 connector", "type": "OAUTH_CONNECTOR", "hosts": ["provider-container"], "criticality": "OPTIONAL", "status_note": "Policy-mandated for dependency pins; registry row only, no config." },
    { "id": "plg.exa", "name": "Exa connector", "type": "OAUTH_CONNECTOR", "hosts": ["provider-container"], "criticality": "OPTIONAL", "status_note": "Registry row only, no config." }
  ],
  "credentials": [
    { "id": "cred.codex-chatgpt-oauth", "purpose": "Hermes primary runtime", "auth_type": "PROVIDER_LOGIN", "location": "~/.codex (CLI keychain)", "hosts": ["dial-hermes-control"], "probe": "codex login status", "expected": "Logged in using ChatGPT", "criticality": "MANDATORY", "owner_action": "codex login (browser) on the control host" },
    { "id": "cred.claude-subscription", "purpose": "Hermes fallback runtime and worker harness", "auth_type": "PROVIDER_LOGIN", "location": "~/.claude / ~/.config/claude", "hosts": ["dial-hermes-control"], "probe": "claude auth status", "criticality": "MANDATORY", "owner_action": "claude login on the control host" },
    { "id": "cred.hermes-openai-codex", "purpose": "Hermes provider binding", "auth_type": "PROVIDER_LOGIN", "location": "~/.hermes", "hosts": ["dial-hermes-control"], "probe": "hermes auth list / config.yaml", "criticality": "MANDATORY", "owner_action": "hermes auth add openai-codex" },
    { "id": "cred.github", "purpose": "Repository clone/push and PR workflow", "auth_type": "SSH_KEY", "location": "~/.ssh or credential helper (control host); provider-managed in containers", "hosts": ["dial-hermes-control", "provider-container"], "probe": "git ls-remote origin HEAD", "criticality": "MANDATORY", "owner_action": "install deploy key or gh auth login" },
    { "id": "cred.chat-control-token", "purpose": "Operator gateway bearer", "auth_type": "NON_INTERACTIVE_SECRET", "location": "/var/lib/dial-control/secrets/chat-control.token", "required_mode": "600", "hosts": ["dial-hermes-control"], "probe": "stat mode 600 and GET /health", "criticality": "MANDATORY", "owner_action": null },
    { "id": "cred.whatsapp-pairing", "purpose": "Owner self-chat pairing", "auth_type": "DEVICE_CODE", "location": "~/.hermes/whatsapp/session/creds.json", "required_mode": "600", "hosts": ["dial-hermes-control"], "probe": "whatsapp-hermes-operator status", "criticality": "OPTIONAL", "owner_action": "bash deploy/oracle/hermes-codex/pair-hermes-whatsapp.sh --foreground (QR scan)" },
    { "id": "cred.whatsapp-cloud", "purpose": "Meta Cloud API adapter", "auth_type": "API_KEY", "location": "/var/lib/dial-control/secrets/whatsapp-operator.json", "required_mode": "600", "hosts": ["dial-hermes-control"], "probe": "whatsapp-operator-adapter status", "criticality": "OPTIONAL" },
    { "id": "cred.xkiro", "purpose": "HAIF auxiliary", "auth_type": "API_KEY", "location": "/var/lib/dial-control/secrets/xkiro-api.key", "required_mode": "600", "hosts": ["dial-hermes-control"], "probe": "haif qualify", "criticality": "OPTIONAL" },
    { "id": "cred.worker-ssh", "purpose": "Control host -> vekl-worker job dispatch", "auth_type": "SSH_KEY", "location": "~/.ssh/dial-worker (control host); authorized_keys restricted to workers/vekl-worker-job.mjs (command= forced)", "hosts": ["dial-hermes-control", "vekl-worker"], "probe": "ssh -o BatchMode=yes vekl-worker true", "criticality": "REQUIRED", "owner_action": "generate dedicated key pair; install forced-command authorized_keys entry on vekl-worker" }
  ],
  "network_dependencies": [
    { "id": "net.github", "target": "https://github.com", "purpose": "repository, PR, CI", "hosts": ["dial-hermes-control", "vekl-worker", "provider-container"], "criticality": "MANDATORY" },
    { "id": "net.github-api", "target": "https://api.github.com", "purpose": "presearch corroboration, MCP", "hosts": ["dial-hermes-control", "provider-container"], "criticality": "REQUIRED" },
    { "id": "net.npm-registry", "target": "https://registry.npmjs.org", "purpose": "npm ci", "hosts": ["dial-hermes-control", "vekl-worker", "provider-container"], "criticality": "MANDATORY" },
    { "id": "net.openai", "target": "https://chatgpt.com", "purpose": "Codex ChatGPT OAuth / App Server", "hosts": ["dial-hermes-control"], "criticality": "MANDATORY" },
    { "id": "net.anthropic", "target": "https://api.anthropic.com", "purpose": "Claude Code subscription route", "hosts": ["dial-hermes-control", "provider-container"], "criticality": "MANDATORY" },
    { "id": "net.stackexchange", "target": "https://api.stackexchange.com", "purpose": "presearch corroboration", "hosts": ["dial-hermes-control"], "criticality": "OPTIONAL" },
    { "id": "net.worker-ssh", "target": "ssh://vekl-worker:22", "purpose": "worker dispatch (private VCN)", "hosts": ["dial-hermes-control"], "criticality": "REQUIRED", "resolve_via": "DIAL_WORKER_SSH_HOST" }
  ],
  "health_checks": [
    { "id": "hc.repo-clean-canonical", "purpose": "repository on canonical lineage with clean tree", "hosts": ["dial-hermes-control"], "criticality": "MANDATORY" },
    { "id": "hc.control-plane-fingerprint", "purpose": "current fingerprint over agent-system/orchestration, agent-system/engineering-knowledge, deploy/oracle/hermes-codex equals the qualified fingerprint in state/external-orchestration-gate.json", "hosts": ["dial-hermes-control"], "criticality": "MANDATORY" },
    { "id": "hc.external-gate", "purpose": "state/external-orchestration-gate.json is PRODUCTION_GREEN or valid DEVELOPMENT_READY_FALLBACK", "hosts": ["dial-hermes-control"], "criticality": "MANDATORY" },
    { "id": "hc.heartbeat", "purpose": "external orchestrator heartbeat fresh (<=2 min)", "hosts": ["dial-hermes-control"], "criticality": "MANDATORY" },
    { "id": "hc.oracle-status-mirror", "purpose": "oracle-runtime-status mirror fresh", "hosts": ["dial-hermes-control", "provider-container"], "criticality": "REQUIRED" },
    { "id": "hc.verify", "purpose": "npm run verify green on current head", "hosts": ["dial-hermes-control", "provider-container"], "criticality": "MANDATORY" }
  ],
  "certification_gates": [
    { "id": "gate.repository-verify", "criticality": "MANDATORY" },
    { "id": "gate.role-guard", "criticality": "MANDATORY" },
    { "id": "gate.provider-auth", "criticality": "MANDATORY" },
    { "id": "gate.hermes-live-qualification", "criticality": "MANDATORY", "evidence": "deploy/oracle/hermes-codex/qualify-control-plane.sh + soaks + finalize-control-plane.sh" },
    { "id": "gate.e2e-selftest", "criticality": "MANDATORY" },
    { "id": "gate.determinism", "criticality": "MANDATORY" },
    { "id": "gate.fault-injection", "criticality": "REQUIRED" },
    { "id": "gate.secrets-hygiene", "criticality": "MANDATORY" }
  ]
}
